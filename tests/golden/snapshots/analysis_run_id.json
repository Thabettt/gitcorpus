  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Analysis · detection #1 · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n    <a href=\"/analysis\" aria-current=\"page\">Analysis</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"analysis-run-header\" data-run-id=\"952\">\n  <div class=\"panel-head\">\n    <div>\n      <p class=\"eyebrow\">Detection #1</p>\n      <h1>Analysis</h1>\n    </div>\n    <div class=\"panel-head-actions\">\n      <a class=\"button ghost\" href=\"/detections/952\">Open detection</a>\n      <a class=\"button ghost\" href=\"/runs/931\">Source search #931</a>\n      <a class=\"button ghost\" href=\"/analysis\">Change run</a>\n    </div>\n  </div>\n  <div class=\"run-meta\">\n    <span>status <span class=\"pill done\">Finished</span></span>\n    <span>source api</span>\n    <span>started 2026-01-02 00:06</span>\n    <span>finished 2026-01-02 00:07</span>\n    <span class=\"mono\">golden-d</span>\n  </div>\n\n  \n\n  <div class=\"cards analysis-kpis\" id=\"analysis-summary\">\n    <article class=\"card\"><h3>Repos scanned</h3><p>1</p></article>\n    <article class=\"card\"><h3>With any agent</h3><p>1 <span class=\"muted\">100.0%</span></p></article>\n    <article class=\"card\"><h3>Readable repos</h3><p>1</p></article>\n    <article class=\"card\"><h3>Unavailable</h3><p>0</p></article>\n    <article class=\"card\"><h3>Known country</h3><p>1 <span class=\"muted\">100.0%</span></p></article>\n    <article class=\"card\"><h3>Unknown country</h3><p>0</p></article>\n  </div>\n\n  <div class=\"analysis-tools\">\n    <details id=\"analysis-country-tools\" class=\"analysis-tool\">\n      <summary>Country coverage and backfill</summary>\n      <p class=\"muted\">\n        Country comes from the repository owner’s GitHub location. 1 of 1 repos have a known country; 0 of 1 owners are still unresolved (1 can still be checked).\n        A backfill fetches missing owner locations through the GitHub API, resolves them with the local geo resolver, and freezes the result into this detection run’s rows.\n      </p>\n      <form method=\"post\" action=\"/analysis/952/country-backfill\" class=\"inline-form\">\n        <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"agent_share\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"agents_by_country\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"adoption\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"adoption_by_country\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"size_vs_adoption\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"agent_debut\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"fingerprint_debut\">\n        \n        <input type=\"hidden\" name=\"metric\" value=\"country_wealth\">\n        \n        <button class=\"button\" type=\"submit\" id=\"analysis-country-backfill\">Resolve missing countries</button>\n        <span class=\"muted\">Up to 500 owners per click; API calls are audited against this run.</span>\n      </form>\n    </details>\n    <details id=\"analysis-metric-picker\" class=\"analysis-tool\">\n      <summary>Choose metrics</summary>\n      <form method=\"get\" action=\"/analysis/952\">\n        <input type=\"hidden\" name=\"metrics_present\" value=\"1\">\n        <div class=\"metric-grid\">\n          \n          <label class=\"metric-option\" for=\"report-metric-agent_share\">\n            <input type=\"checkbox\" id=\"report-metric-agent_share\" name=\"metric\" value=\"agent_share\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Agent share</span>\n              <span class=\"metric-option-desc\">Repos with each agent, as a share of every scanned repo and of readable repos.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-agents_by_country\">\n            <input type=\"checkbox\" id=\"report-metric-agents_by_country\" name=\"metric\" value=\"agents_by_country\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Agents by country</span>\n              <span class=\"metric-option-desc\">Repo counts per country and agent. Unknown country is its own bucket.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-adoption\">\n            <input type=\"checkbox\" id=\"report-metric-adoption\" name=\"metric\" value=\"adoption\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Agent use</span>\n              <span class=\"metric-option-desc\">Share of repos with at least one agent, plus the adoption-level mix.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-adoption_by_country\">\n            <input type=\"checkbox\" id=\"report-metric-adoption_by_country\" name=\"metric\" value=\"adoption_by_country\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Agent use by country</span>\n              <span class=\"metric-option-desc\">Adoption rate per country, repo-weighted. Unknown country is its own bucket.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-size_vs_adoption\">\n            <input type=\"checkbox\" id=\"report-metric-size_vs_adoption\" name=\"metric\" value=\"size_vs_adoption\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Repo size vs agent use</span>\n              <span class=\"metric-option-desc\">Adoption rate by repository size bucket, with per-agent rates.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-agent_debut\">\n            <input type=\"checkbox\" id=\"report-metric-agent_debut\" name=\"metric\" value=\"agent_debut\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Agent debuts</span>\n              <span class=\"metric-option-desc\">Earliest observed signal per agent, plus the earliest repo that carries it.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-fingerprint_debut\">\n            <input type=\"checkbox\" id=\"report-metric-fingerprint_debut\" name=\"metric\" value=\"fingerprint_debut\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Fingerprint debuts</span>\n              <span class=\"metric-option-desc\">Earliest observed signal for the top file, branch, trailer, author, label, and issue fingerprints per agent.</span>\n            </span>\n          </label>\n          \n          <label class=\"metric-option\" for=\"report-metric-country_wealth\">\n            <input type=\"checkbox\" id=\"report-metric-country_wealth\" name=\"metric\" value=\"country_wealth\" checked>\n            <span class=\"metric-option-copy\">\n              <span class=\"metric-option-title\">Country wealth vs agent use</span>\n              <span class=\"metric-option-desc\">GDP per capita and income group against adoption rate.</span>\n            </span>\n          </label>\n          \n        </div>\n        <div class=\"analysis-picker-actions\">\n          <button class=\"button primary\" type=\"submit\" id=\"analysis-metrics-apply\">Apply selection</button>\n          <span class=\"muted\">Sections with no data are hidden.</span>\n        </div>\n      </form>\n    </details>\n  </div>\n</section>\n\n\n\n<nav class=\"report-tabs\" id=\"analysis-tabs\" role=\"tablist\" aria-label=\"Analysis sections\">\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-agent_share\" data-target=\"analysis-agent-share\" aria-controls=\"analysis-agent-share\" aria-selected=\"false\" tabindex=\"-1\">\n    Agent share\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-agents_by_country\" data-target=\"analysis-agents-by-country\" aria-controls=\"analysis-agents-by-country\" aria-selected=\"false\" tabindex=\"-1\">\n    Agents by country\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-adoption\" data-target=\"analysis-adoption\" aria-controls=\"analysis-adoption\" aria-selected=\"false\" tabindex=\"-1\">\n    Agent use\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-adoption_by_country\" data-target=\"analysis-adoption-by-country\" aria-controls=\"analysis-adoption-by-country\" aria-selected=\"false\" tabindex=\"-1\">\n    Agent use by country\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-size_vs_adoption\" data-target=\"analysis-size-vs-adoption\" aria-controls=\"analysis-size-vs-adoption\" aria-selected=\"false\" tabindex=\"-1\">\n    Repo size vs agent use\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-agent_debut\" data-target=\"analysis-agent-debut\" aria-controls=\"analysis-agent-debut\" aria-selected=\"false\" tabindex=\"-1\">\n    Agent debuts\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-fingerprint_debut\" data-target=\"analysis-fingerprint-debut\" aria-controls=\"analysis-fingerprint-debut\" aria-selected=\"false\" tabindex=\"-1\">\n    Fingerprint debuts\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n  \n  <button class=\"report-tab\" type=\"button\" role=\"tab\" id=\"tab-country_wealth\" data-target=\"analysis-country-wealth\" aria-controls=\"analysis-country-wealth\" aria-selected=\"false\" tabindex=\"-1\">\n    Country wealth vs agent use\n    <span class=\"report-tab-count\">1</span>\n  </button>\n  \n</nav>\n\n<div class=\"report-sections\" id=\"analysis-sections\">\n\n\n<section class=\"panel analysis-section\" id=\"analysis-agent-share\" role=\"tabpanel\" aria-labelledby=\"tab-agent_share\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Agent share</h2><p class=\"muted\">Repos with each agent, as a share of every scanned repo and of readable repos. A repo can use several agents, so shares do not sum to 100%.</p></div></div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Agent</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Share of scanned</th><th scope=\"col\" class=\"num\">Share of readable</th></tr></thead>\n      <tbody>\n      \n        <tr>\n          <td>Claude Code</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">\n            100.0%\n            <div class=\"progress\" aria-hidden=\"true\"><div class=\"progress-bar\" style=\"--progress: 1.0\"></div></div>\n          </td>\n          <td class=\"num\">100.0%</td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-agents-by-country\" role=\"tabpanel\" aria-labelledby=\"tab-agents_by_country\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Agents by country</h2><p class=\"muted\">Repo counts per country and agent, repo-weighted. “Unknown” is the bucket for repos whose owner country could not be resolved. Countries with no agent signal are omitted here; see Agent use by country for full adoption rates.</p></div></div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Country</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Readable</th><th scope=\"col\">Agents (repos)</th></tr></thead>\n      <tbody>\n      \n        <tr>\n          <td>Germany <span class=\"muted mono\">DE</span></td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td>\n            <span class=\"agent-chips\">\n              \n              <span class=\"agent-chip\">Claude Code <strong>1</strong> <span class=\"muted\">100.0%</span></span>\n              \n              \n            </span>\n          </td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-adoption\" role=\"tabpanel\" aria-labelledby=\"tab-adoption\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Agent use</h2><p class=\"muted\">Share of repos with at least one agent. Readable repos exclude repos the detection could not read.</p></div></div>\n  <div class=\"cards\">\n    <article class=\"card\"><h3>All scanned</h3><p>1 / 1 <span class=\"muted\">100.0%</span></p></article>\n    <article class=\"card\"><h3>Readable</h3><p>1 / 1 <span class=\"muted\">100.0%</span></p></article>\n  </div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Adoption level</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Share</th></tr></thead>\n      <tbody>\n      \n        <tr><td>pervasive</td><td class=\"num\">1</td><td class=\"num\">100.0%</td></tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-adoption-by-country\" role=\"tabpanel\" aria-labelledby=\"tab-adoption_by_country\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Agent use by country</h2><p class=\"muted\">Repo-weighted adoption rate per country. Unknown country is its own bucket. Rates use readable repos as the denominator.</p></div></div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Country</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Readable</th><th scope=\"col\" class=\"num\">With agent</th><th scope=\"col\" class=\"num\">Adoption</th></tr></thead>\n      <tbody>\n      \n        <tr>\n          <td>Germany <span class=\"muted mono\">DE</span></td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">\n            100.0%\n            <div class=\"progress\" aria-hidden=\"true\"><div class=\"progress-bar\" style=\"--progress: 1.0\"></div></div>\n          </td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-size-vs-adoption\" role=\"tabpanel\" aria-labelledby=\"tab-size_vs_adoption\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Repo size vs agent use</h2><p class=\"muted\">Adoption by repository size in kilobytes. The per-agent columns are shares of readable repos in that bucket; they do not sum to 100% because a repo can use several agents.</p></div></div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead>\n        <tr><th scope=\"col\">Size bucket</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Readable</th><th scope=\"col\" class=\"num\">With agent</th><th scope=\"col\" class=\"num\">Adoption</th>\n        <th scope=\"col\" class=\"num\">Claude Code</th></tr>\n      </thead>\n      <tbody>\n      \n        <tr>\n          <td>100–500 KB</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">100.0%</td>\n          <td class=\"num\">100.0%</td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-agent-debut\" role=\"tabpanel\" aria-labelledby=\"tab-agent_debut\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Agent debuts</h2><p class=\"muted\">Earliest observed date in the run’s detection window for each agent, and the earliest repository creation date among repos that carry it. The observed signal can only be later than the true first use because detection is windowed.</p></div></div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Agent</th><th scope=\"col\">Earliest observed signal</th><th scope=\"col\">Earliest repo created</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\" class=\"num\">Dated repos</th></tr></thead>\n      <tbody>\n      \n        <tr><td>Claude Code</td><td>2026-01-02</td><td>2024-01-01</td><td class=\"num\">1</td><td class=\"num\">1</td></tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-fingerprint-debut\" role=\"tabpanel\" aria-labelledby=\"tab-fingerprint_debut\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Fingerprint debuts</h2><p class=\"muted\">Top fingerprints per agent by repo count. “Earliest observed signal” is the earliest repo-level first signal among repos that carry the fingerprint; the true first appearance can be earlier. Derived PR propagation rows and bots are excluded.</p></div></div>\n  <div class=\"analysis-scroll\">\n    \n    <details class=\"evidence-repo\" id=\"analysis-fingerprint-claude-code\">\n      <summary>Claude Code · 1 fingerprints</summary>\n      <div class=\"evidence-body\">\n        <div class=\"table-scroll\">\n          <table class=\"data-table\">\n            <thead><tr><th scope=\"col\">Fingerprint</th><th scope=\"col\">Channel</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\">Earliest observed signal</th><th scope=\"col\">Earliest repo created</th></tr></thead>\n            <tbody>\n            \n              <tr><td class=\"mono\">CLAUDE.md</td><td>file</td><td class=\"num\">1</td><td>2026-01-02</td><td>2024-01-01</td></tr>\n            \n            </tbody>\n          </table>\n        </div>\n      </div>\n    </details>\n    \n  </div>\n</section>\n\n\n\n<section class=\"panel analysis-section\" id=\"analysis-country-wealth\" role=\"tabpanel\" aria-labelledby=\"tab-country_wealth\" tabindex=\"0\">\n  <div class=\"panel-head\"><div><h2>Country wealth vs agent use</h2><p class=\"muted\">GDP per capita and income group against repo-weighted adoption. This compares country aggregates, not individual developers or repositories, so it cannot support claims about any one person.</p></div></div>\n  <div class=\"cards\">\n    <article class=\"card\"><h3>Pearson r</h3><p>—</p></article>\n    <article class=\"card\"><h3>Countries in fit</h3><p>0</p></article>\n    <article class=\"card\"><h3>Minimum readable repos</h3><p>10</p></article>\n  </div>\n  <p class=\"muted\">World Bank: GDP per capita (current US$, latest available year) and income group (FY2025 classification). Correlation uses log10 GDP per capita and adoption fraction for countries with at least 10 readable repos; it is descriptive, not causal.</p>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Income group</th><th scope=\"col\" class=\"num\">Countries</th><th scope=\"col\" class=\"num\">Readable repos</th><th scope=\"col\" class=\"num\">With agent</th><th scope=\"col\" class=\"num\">Adoption</th></tr></thead>\n      <tbody>\n      \n        <tr><td>High income</td><td class=\"num\">1</td><td class=\"num\">1</td><td class=\"num\">1</td><td class=\"num\">100.0%</td></tr>\n      \n      </tbody>\n    </table>\n  </div>\n  <div class=\"table-scroll sticky-head\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Country</th><th scope=\"col\">Income group</th><th scope=\"col\" class=\"num\">GDP per capita</th><th scope=\"col\" class=\"num\">Readable repos</th><th scope=\"col\" class=\"num\">With agent</th><th scope=\"col\" class=\"num\">Adoption</th></tr></thead>\n      <tbody>\n      \n        <tr>\n          <td>Germany <span class=\"muted mono\">DE</span></td>\n          <td>High income</td>\n          <td class=\"num\">$56,104 <span class=\"muted\">2024</span></td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">1</td>\n          <td class=\"num\">100.0%</td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n</section>\n\n\n</div>\n\n\n<script>\n(function () {\n  \"use strict\";\n  var tabs = Array.prototype.slice.call(document.querySelectorAll(\"#analysis-tabs [role='tab']\"));\n  var sections = Array.prototype.slice.call(document.querySelectorAll(\".analysis-section\"));\n  if (!tabs.length || !sections.length) { return; }\n\n  function activate(target, updateHash) {\n    tabs.forEach(function (tab) {\n      var selected = tab.getAttribute(\"data-target\") === target;\n      tab.setAttribute(\"aria-selected\", selected ? \"true\" : \"false\");\n      tab.tabIndex = selected ? 0 : -1;\n    });\n    sections.forEach(function (section) {\n      section.hidden = section.id !== target;\n    });\n    if (updateHash) {\n      history.replaceState(null, \"\", \"#\" + target.replace(/^analysis-/, \"\"));\n      var panel = document.getElementById(target);\n      var reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n      if (panel) {\n        panel.scrollIntoView({ behavior: reduce ? \"auto\" : \"smooth\", block: \
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<title>Compare search 931 · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\" aria-current=\"page\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <span class=\"nav-soon\" aria-disabled=\"true\" title=\"coming soon..\">Detections</span>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"diff-header\" data-run-id=\"931\" data-against=\"932\">\n  <div class=\"panel-head\">\n    <h1>Compare search #932 with #931</h1>\n    <a class=\"button ghost\" href=\"/runs/931\">Back to search</a>\n  </div>\n  <form id=\"diff-baseline-form\" class=\"diff-baseline-form\" action=\"/runs/931/diff\" method=\"get\">\n    <label class=\"field\" for=\"diff-baseline\">\n      <span class=\"field-label\">Compare with an earlier search of the same filters</span>\n      <select id=\"diff-baseline\" class=\"field-input\" name=\"against\">\n        <option value=\"\" >— choose an earlier search —</option>\n        \n        <option id=\"diff-option-932\" value=\"932\" selected>#932 · Finished — incomplete · <relative-time></option>\n        \n      </select>\n    </label>\n    <div class=\"form-actions\">\n      <button class=\"button\" type=\"submit\">Compare</button>\n    </div>\n  </form>\n  <p class=\"diff-direction muted\">\n    <span id=\"diff-baseline-label\" data-run-id=\"932\">baseline #932</span>\n    →\n    <span id=\"diff-viewed-label\" data-run-id=\"931\">viewed #931</span>\n  </p>\n  \n  <div id=\"diff-summary\" class=\"summary-grid\">\n    <div class=\"card diff-card\" data-summary=\"added\">\n      <span class=\"diff-label\">New repos</span>\n      <strong data-count=\"added\">2</strong>\n      <p class=\"muted\">Added in viewed #931, not in baseline #932</p>\n    </div>\n    <div class=\"card diff-card\" data-summary=\"removed\">\n      <span class=\"diff-label\">Gone</span>\n      <strong data-count=\"removed\">1</strong>\n      <p class=\"muted\">Removed from baseline #932, not in viewed #931</p>\n    </div>\n    <div class=\"card diff-card\" data-summary=\"changed\">\n      <span class=\"diff-label\">Changed</span>\n      <strong data-count=\"changed\">1</strong>\n      <p class=\"muted\">repos changed · 1 fields</p>\n    </div>\n  </div>\n  \n  <section class=\"panel diff-section\" id=\"diff-added-section\">\n    <div class=\"panel-head\"><h2>Added in viewed #931 (not in baseline #932)</h2></div>\n    <div class=\"table-wrap\">\n      <table id=\"diff-added\" class=\"data-table\">\n        <thead>\n          <tr><th scope=\"col\">Repo id</th><th scope=\"col\">Repository</th></tr>\n        </thead>\n        <tbody>\n        \n          <tr data-repo-id=\"912\" data-full-name=\"octo/beta\">\n            <td class=\"mono\">912</td>\n            <td>octo/beta</td>\n          </tr>\n        \n          <tr data-repo-id=\"913\" data-full-name=\"octo/gamma\">\n            <td class=\"mono\">913</td>\n            <td>octo/gamma</td>\n          </tr>\n        \n        </tbody>\n      </table>\n    </div>\n  </section>\n  <section class=\"panel diff-section\" id=\"diff-removed-section\">\n    <div class=\"panel-head\"><h2>Removed from baseline #932 (not in viewed #931)</h2></div>\n    <div class=\"table-wrap\">\n      <table id=\"diff-removed\" class=\"data-table\">\n        <thead>\n          <tr><th scope=\"col\">Repo id</th><th scope=\"col\">Repository</th></tr>\n        </thead>\n        <tbody>\n        \n          <tr data-repo-id=\"914\" data-full-name=\"octo/delta\">\n            <td class=\"mono\">914</td>\n            <td>octo/delta</td>\n          </tr>\n        \n        </tbody>\n      </table>\n    </div>\n  </section>\n  <section class=\"panel diff-section\" id=\"diff-changed-section\">\n    <div class=\"panel-head\"><h2>Changed from baseline #932 to viewed #931</h2></div>\n    <div class=\"table-wrap\">\n      <table id=\"diff-changed\" class=\"data-table\">\n        <thead>\n          <tr>\n            <th scope=\"col\">Repository</th>\n            <th scope=\"col\">Field</th>\n            <th scope=\"col\">From baseline</th>\n            <th scope=\"col\">To viewed</th>\n          </tr>\n        </thead>\n        <tbody>\n        \n          <tr data-repo-id=\"911\" data-full-name=\"octo/alpha\" data-field=\"stargazers\">\n            <td>octo/alpha</td>\n            <td class=\"mono\">stargazers</td>\n            <td class=\"diff-from\">250</td>\n            <td class=\"diff-to\">300</td>\n          </tr>\n        \n        </tbody>\n      </table>\n    </div>\n  </section>\n  \n  \n</section>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n  
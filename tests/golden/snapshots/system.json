{
  "path": "/system",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<title>System · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\" aria-current=\"page\">System</a>\n    <span class=\"nav-soon\" aria-disabled=\"true\" title=\"coming soon..\">Detections</span>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h1>System</h1>\n    <p class=\"muted\">Health, performance, and limits for this machine.</p>\n  </div>\n</section>\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h2>Status</h2>\n  </div>\n  <div class=\"health-grid\">\n    <div class=\"card health-card\">\n      <span class=\"health-label\">Database</span>\n      <span class=\"badge ok\">ok</span>\n    </div>\n    <div class=\"card health-card\">\n      <span class=\"health-label\">Redis</span>\n      <span class=\"badge ok\">ok</span>\n    </div>\n    <div class=\"card health-card\">\n      <span class=\"health-label\">GitHub token</span>\n      <span class=\"badge ok\">present</span>\n    </div>\n  </div>\n  \n</section>\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h2>Performance</h2>\n    <p class=\"muted\">Rates and response times cover the last 1,000 requests; failed-search counts are live.</p>\n  </div>\n  <div class=\"table-wrap\">\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">Measure</th>\n          <th scope=\"col\">Value</th>\n          <th scope=\"col\">State</th>\n        </tr>\n      </thead>\n      <tbody>\n      \n        \n        <tr>\n          <td>GraphQL points left this hour</td>\n          <td>n/a</td>\n          <td><span class=\"badge na\">no data</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Searches that came back incomplete</td>\n          <td>n/a</td>\n          <td><span class=\"badge na\">no data</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Rejected filters</td>\n          <td>0.0</td>\n          <td><span class=\"badge ok\">fine</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Throttled responses</td>\n          <td>0.0</td>\n          <td><span class=\"badge ok\">fine</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Median response (ms)</td>\n          <td>12.0</td>\n          <td><span class=\"badge ok\">fine</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Search coverage</td>\n          <td>n/a</td>\n          <td><span class=\"badge na\">no data</span></td>\n        </tr>\n        \n      \n        \n        <tr>\n          <td>Owners without a country</td>\n          <td>0.0</td>\n          <td><span class=\"badge ok\">fine</span></td>\n        </tr>\n        \n      \n        <tr>\n          <td>Failed searches (all time)</td>\n          <td>0</td>\n          <td><span class=\"badge ok\">none</span></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h2>Limits</h2>\n  </div>\n  <p class=\"muted\">How broad a search may be, how many repos it keeps and saves, how long it may\n    run, and how requests are paced. Env-pinned values show a “set by environment” badge.</p>\n  <p><a class=\"button\" href=\"/settings\">Open limits</a></p>\n</section>\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

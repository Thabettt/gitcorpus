  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>rust thesis frame · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\" aria-current=\"page\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"corpus-header\" data-corpus-id=\"951\">\n  <div class=\"panel-head\">\n    <h1>rust thesis frame</h1>\n    <p class=\"muted\">Frozen 2026-01-02T00:06:00Z. These details are exactly what we saw at that\n      moment; later changes on GitHub do not alter this corpus.</p>\n  </div>\n  <p id=\"corpus-note\">thesis frame</p>\n  <p class=\"muted\" id=\"corpus-source\">From search <a href=\"/runs/931\">#931</a>\n    · Rust · 3 repos</p>\n</section>\n<section class=\"panel\" id=\"corpus-actions\">\n  <div class=\"form-actions\">\n    <a id=\"corpus-export-json\" class=\"button\" href=\"/runs/931/export?format=json\">Export JSON</a>\n    <a id=\"corpus-export-csv\" class=\"button\" href=\"/runs/931/export?format=csv\">Export CSV</a>\n    <a id=\"corpus-view-all\" class=\"button\" href=\"/runs/931/results\">View all results</a>\n    <a id=\"corpus-detect\" class=\"button\" href=\"/detections/from/931\" title=\"Scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo.\">Detect agent use</a>\n    <button id=\"corpus-delete-open\" class=\"button danger\" type=\"button\"\n            data-open=\"corpus-delete-modal\">Delete corpus</button>\n    <noscript>\n      <form id=\"corpus-delete\" action=\"/corpora/951/delete\" method=\"post\">\n        <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n        <button class=\"button danger\" type=\"submit\">Delete corpus</button>\n      </form>\n    </noscript>\n  </div>\n  <p class=\"muted\" id=\"corpus-detect-note\">Detect agent use scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo.</p>\n  <p class=\"muted\">Export downloads the frozen result list as JSON or CSV. Deleting a corpus never affects its source search — the search and its results stay exactly as they are.</p>\n  <p><a href=\"/corpora\">All corpora</a></p>\n</section>\n<section class=\"panel\" id=\"corpus-preview\">\n  <div class=\"panel-head\">\n    <h2>Preview</h2>\n    <p class=\"muted\">The first 20 repos in this corpus.</p>\n  </div>\n  \n  \n<p id=\"run-table-count\" class=\"muted\" data-total=\"3\" data-shown=\"3\">Showing 3 of 3 rows</p>\n<div class=\"table-wrap\">\n  <table id=\"run-items\" class=\"data-table\">\n    <thead>\n      <tr>\n        <th scope=\"col\" class=\"col-gutter\"><span class=\"sr-only\">Row</span></th>\n        <th scope=\"col\">\n\n\n<a class=\"sort-link\" data-sort=\"name\" data-dir=\"desc\"\n   href=\"/runs/931/results?sort=name&dir=desc&page=1&per_page=20\">Repository<span class=\"sort-mark\" aria-hidden=\"true\">&#8645;</span></a>\n\n</th>\n        <th scope=\"col\" class=\"num\">\n\n\n<a class=\"sort-link active\" data-sort=\"stars\" data-dir=\"asc\"\n   href=\"/runs/931/results?sort=stars&dir=asc&page=1&per_page=20\">Stars<span class=\"sort-mark\" aria-hidden=\"true\">&#8645;</span></a>\n\n</th>\n        \n        <th scope=\"col\">\n\n\n<a class=\"sort-link\" data-sort=\"pushed\" data-dir=\"desc\"\n   href=\"/runs/931/results?sort=pushed&dir=desc&page=1&per_page=20\">Updated<span class=\"sort-mark\" aria-hidden=\"true\">&#8645;</span></a>\n\n</th>\n        \n        \n        <th scope=\"col\">Country</th>\n        <th scope=\"col\">Flags</th>\n        \n      </tr>\n    </thead>\n    <tbody>\n    \n      <tr id=\"run-item-911\" data-full-name=\"octo/alpha\">\n        <td class=\"gutter\">01</td>\n        <td><span class=\"repo-name\">octo/alpha</span><span class=\"repo-sub mono\">id 911 · 2025-12-30T12:00:00Z</span></td>\n        <td class=\"num\">300</td>\n        \n    
{
  "path": "/detections/from/931",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Detect agent use · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\" aria-current=\"page\">Detections</a>\n    <a href=\"/analysis\">Analysis</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"detect-options\" data-run-id=\"931\">\n  <div class=\"panel-head\">\n    <h1>Detect agent use — search #931</h1>\n    <p class=\"muted\">Scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo. It never calls discovery/search endpoints and never copies code.</p>\n  </div>\n  \n  \n  <form id=\"detect-form\" action=\"/detections/from/931\" method=\"post\">\n    <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n    <section class=\"filter-section\" id=\"detect-method-section\">\n      <h2>Detection method</h2>\n      <p class=\"muted\">Two methods are available per run and produce the same evidence tables — they differ in where the data comes from and what they cost. The API method stays the default; local clone is additive, not a replacement.</p>\n      <div class=\"method-grid\">\n        <label class=\"method-card\" for=\"detect-source-api\">\n          <input type=\"radio\" id=\"detect-source-api\" name=\"source\" value=\"api\" checked>\n          <span class=\"method-title\">GitHub API — default</span>\n          <ul class=\"method-pros\">\n            <li>No downloads and no disk; starts instantly — small corpora finish in seconds.</li>\n            <li>The only method that can read the <code>label</code> and <code>issue</code> channels.</li>\n          </ul>\n          <ul class=\"method-cons\">\n            <li>Rate-limited: 5,000 REST requests + 5,000 GraphQL points per hour per account.</li>\n            <li>Large corpora are slow (≈13 h for 17.7k repos) and stall when the quota is spent; long runs are fragile to interruptions.</li>\n          </ul>\n        </label>\n        <label class=\"method-card\" for=\"detect-source-git\">\n          <input type=\"radio\" id=\"detect-source-git\" name=\"source\" value=\"git\">\n          <span class=\"method-title\">Local clone (git) — new</span>\n          <ul class=\"method-pros\">\n            <li>No API quota and no tokens required — 17.7k repos scan in ≈1 h (measured).</li>\n            <li>Same evidence for every channel except <code>label</code> and <code>issue</code> — 99.5% of detected repos recovered in validation against the API run.</li>\n            <li>Clones can be kept so interrupted scans resume without re-downloading.</li>\n          </ul>\n          <ul class=\"method-cons\">\n            <li>Downloads ≈4 GB of lean clones for 17.7k repos; peak disk stays under 1 GB because each clone is deleted after its scan (keeping is opt-in).</li>\n            <li><code>label</code> and <code>issue</code> are API-only and are recorded as skipped.</li>\n            <li>Branch names are recovered only for projects that merge with merge commits (23% measured).</li>\n            <li>Needs git installed.</li>\n          </ul>\n        </label>\n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-pack-section\">\n      <h2>Trace pack</h2>\n      <p class=\"muted\">The immutable pattern set used for matching. Packs are independent: each one carries its own agents and supports its own channels, and the lists below show only what the selected pack can detect. Every stored evidence row carries this version.</p>\n      <div class=\"field-grid\">\n        <label class=\"field\" for=\"detect-pack\">\n          <span class=\"field-label\">Pack version</span>\n          <select class=\"field-input\" id=\"detect-pack\" name=\"pack_version\">\n            <option value=\"golden-pack\" selected>golden-pack · 3 agents · 8 channels · schema v1</option>\n          </select>\n        </label>\n      </div>\n      <script type=\"application/json\" id=\"detect-pack-options\">{\"golden-pack\": {\"agents\": [{\"category\": \"active\", \"name\": \"Claude Code\"}, {\"category\": \"active\", \"name\": \"Codex\"}, {\"category\": \"active\", \"name\": \"Generic\"}], \"channels\": [\"file\", \"author\", \"branch\", \"label\", \"bot\", \"commit_trailer\", \"pr_metadata\", \"issue\"], \"default_channels\": [\"file\", \"author\", \"branch\", \"label\", \"bot\", \"commit_trailer\", \"pr_metadata\", \"issue\"]}}</script>\n      <script type=\"application/json\" id=\"detect-channel-notes\">{\"author\": \"Commit author/committer identities \\u00b7 shares the history call\", \"bot\": \"Generic CI bots, QA evidence only \\u00b7 shares the history call\", \"branch\": \"PR head branches \\u00b7 shares the PR call\", \"commit_trailer\": \"Co-author / generated-by trailers \\u00b7 shares the history call\", \"file\": \"Tree + .gitignore + content probes \\u00b7 2+ REST calls\", \"hidden_ref\": \"Opt-in checkpoint/recovery namespaces \\u00b7 up to 6 bounded REST calls or targeted git metadata\", \"issue\": \"Agent users in issues and PR comments \\u00b7 1 GraphQL call\", \"label\": \"PR labels \\u00b7 shares the PR call\", \"pr_metadata\": \"PR author, body marker, PR\\u2192commit propagation \\u00b7 1 GraphQL call\"}</script>\n    </section>\n    <section class=\"filter-section\" id=\"detect-agents-section\">\n      <div class=\"detect-section-head\">\n        <h2>Agents (<span id=\"detect-agents-count\">3</span>)</h2>\n        <div class=\"checklist-tools\">\n          <input type=\"search\" id=\"detect-agent-search\" class=\"field-input checklist-search\" aria-label=\"Search agents\" placeholder=\"Search agents…\">\n          <button type=\"button\" id=\"detect-agents-all\" class=\"button ghost\">Select all</button>\n          <button type=\"button\" id=\"detect-agents-none\" class=\"button ghost\">Select none</button>\n        </div>\n      </div>\n      <p class=\"muted\">The selected pack’s roster. Only the selected agents are matched, counted, and exported; keeping all checked scans for every agent the pack knows. Selection narrows matching, not fetching — the same API calls run either way. Agents marked <em>legacy</em> are matched only through historical evidence.</p>\n      <div class=\"checklist\" id=\"detect-agents\">\n        \n        <label class=\"checkbox\" data-agent=\"Claude Code\"><input type=\"checkbox\" name=\"agents\" value=\"Claude Code\" checked> <span>Claude Code</span></label>\n        \n        <label class=\"checkbox\" data-agent=\"Codex\"><input type=\"checkbox\" name=\"agents\" value=\"Codex\" checked> <span>Codex</span></label>\n        \n        <label class=\"checkbox\" data-agent=\"Generic\"><input type=\"checkbox\" name=\"agents\" value=\"Generic\" checked> <span>Generic</span></label>\n        \n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-channels-section\">\n      <div class=\"detect-section-head\">\n        <h2>Channels (<span id=\"detect-channels-count\">8</span>)</h2>\n        <div class=\"checklist-tools\">\n          <button type=\"button\" id=\"detect-channels-all\" class=\"button ghost\">Select all</button>\n          <button type=\"button\" id=\"detect-channels-none\" class=\"button ghost\">Select none</button>\n        </div>\n      </div>\n      <p class=\"muted\">The channels the selected pack supports — independent heuristics, each run per repo and grouped in the results. Several channels share one API call; the per-repo cost is noted next to each. Opt-in channels start unchecked.</p>\n      <div class=\"checklist checklist-channels\" id=\"detect-channels\">\n        \n        <label class=\"checkbox channel-row\" data-channel=\"file\">\n          <input type=\"checkbox\" name=\"channels\" value=\"file\" checked>\n          <span class=\"channel-name\">file</span>\n          <span class=\"channel-note muted\">Tree + .gitignore + content probes · 2+ REST calls</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"author\">\n          <input type=\"checkbox\" name=\"channels\" value=\"author\" checked>\n          <span class=\"channel-name\">author</span>\n          <span class=\"channel-note muted\">Commit author/committer identities · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"branch\">\n          <input type=\"checkbox\" name=\"channels\" value=\"branch\" checked>\n          <span class=\"channel-name\">branch</span>\n          <span class=\"channel-note muted\">PR head branches · shares the PR call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"label\">\n          <input type=\"checkbox\" name=\"channels\" value=\"label\" checked>\n          <span class=\"channel-name\">label</span>\n          <span class=\"channel-note muted\">PR labels · shares the PR call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"bot\">\n          <input type=\"checkbox\" name=\"channels\" value=\"bot\" checked>\n          <span class=\"channel-name\">bot</span>\n          <span class=\"channel-note muted\">Generic CI bots, QA evidence only · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"commit_trailer\">\n          <input type=\"checkbox\" name=\"channels\" value=\"commit_trailer\" checked>\n          <span class=\"channel-name\">commit_trailer</span>\n          <span class=\"channel-note muted\">Co-author / generated-by trailers · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"pr_metadata\">\n          <input type=\"checkbox\" name=\"channels\" value=\"pr_metadata\" checked>\n          <span class=\"channel-name\">pr_metadata</span>\n          <span class=\"channel-note muted\">PR author, body marker, PR→commit propagation · 1 GraphQL call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\" data-channel=\"issue\">\n          <input type=\"checkbox\" name=\"channels\" value=\"issue\" checked>\n          <span class=\"channel-name\">issue</span>\n          <span class=\"channel-note muted\">Agent users in issues and PR comments · 1 GraphQL call</span>\n        </label>\n        \n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-scope-section\">\n      <h2>Scope</h2>\n      <p class=\"muted\">Detection walks the frozen result list in star order (most stars first). A top-N limit is useful for pilot runs; the estimate below updates as you change options — including the git clone depth and the kept-clones choice.</p>\n      <div class=\"field-grid\">\n        <label class=\"field\" for=\"detect-limit\">\n          <span class=\"field-label\">Top-N repos</span>\n          <input class=\"field-input\" id=\"detect-limit\" name=\"limit\" type=\"number\" min=\"1\" placeholder=\"All 3\">\n          <span class=\"field-note muted\">Blank = all 3 frozen repos.</span>\n        </label>\n        <label class=\"field\" for=\"detect-scan-fast\" data-api-field>\n          <span class=\"field-label\">Fast mode</span>\n          <input class=\"field-input\" id=\"detect-scan-fast\" type=\"checkbox\" name=\"scan_mode\" value=\"fast\">\n          <span class=\"field-note muted\">API method only. Skips reading every workflow and compose file in each repo, which roughly halves REST calls on schema-v2 packs. Same agents and channels; only content rules on broad paths (for example PR-Agent's workflow and compose checks) are skipped, and the run is labelled fast.</span>\n        </label>\n        <label class=\"field\" for=\"detect-clone-depth\" data-git-field>\n          <span class=\"field-label\">Clone depth (last N commits)</span>\n          <input class=\"field-input\" id=\"detect-clone-depth\" name=\"clone_depth\" type=\"number\" min=\"1\" max=\"5000\" value=\"100\">\n          <span class=\"field-note muted\">Git method only — the history each lean clone carries.</span>\n        </label>\n        <label class=\"field\" data-git-field>\n          <span class=\"field-label\">Keep clones on disk</span>\n          <input class=\"field-input\" type=\"checkbox\" name=\"clone_keep\" value=\"true\">\n          <span class=\"field-note muted\">Off = delete each repo after its scan.</span>\n        </label>\n      </div>\n      <div id=\"detect-estimate\"\n           hx-get=\"/partials/detections/931/estimate\"\n           hx-trigger=\"load, change from:#detect-form\"\n           hx-include=\"#detect-form\"\n           hx-swap=\"outerHTML\">\n        <p class=\"muted\">Estimating…</p>\n      </div>\n    </section>\n    <div class=\"form-actions\">\n      <button id=\"detect-start\" class=\"button primary\" type=\"submit\">Start detection</button>\n      <a class=\"button\" href=\"/runs/931\">Cancel</a>\n    </div>\n    <p class=\"muted\">Starts a detect run on its own GitHub allowance. Progress, cancel, and resume work like any other run, and results land on the run’s detection page.</p>\n  </form>\n  <p class=\"muted\">Depth is windowed: last 100 commits, most recent 100 PRs and issues — labelled as windowed, never presented as a census. Tier boundaries are documented in <code>docs/detection-tiers.md</code>. Detection is an undercount: agents that hide their traces are not visible.</p>\n  <p><a href=\"/detections\">All detections</a></p>\n</section>\n<script>\n(function () {\n  \"use strict\";\n  var form = document.getElementById(\"detect-form\");\n  function notifyChanged() {\n    if (form) {\n      form.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    }\n  }\n  if (form) {\n    form.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Enter\" && event.target.type !== \"submit\") {\n        event.preventDefault();\n      }\n    });\n  }\n  function readJson(id) {\n    var node = document.getElementById(id);\n    if (!node) {\n      return {};\n    }\n    try {\n      return JSON.parse(node.textContent || \"{}\");\n    } catch (error) {\n      return {};\n    }\n  }\n  var packData = readJson(\"detect-pack-options\");\n  var channelNotes = readJson(\"detect-channel-notes\");\n  var packSelect = document.getElementById(\"detect-pack\");\n  var agentList = document.getElementById(\"detect-agents\");\n  var channelList = document.getElementById(\"detect-channels\");\n  var agentCount = document.getElementById(\"detect-agents-count\");\n  var channelCount = document.getElementById(\"detect-channels-count\");\n  var search = document.getElementById(\"detect-agent-search\");\n  var gitFields = document.querySelectorAll(\"[data-git-field]\");\n  var apiFields = document.querySelectorAll(\"[data-api-field]\");\n  var gitRadio = document.getElementById(\"detect-source-git\");\n  var apiOnlyValues = { label: true, issue: true };\n  var unavailableNote = \" (unavailable with git detection — API-only channel)\";\n  var categoryLabels = { \"legacy-only\": \"legacy\" };\n\n  function el(tag, attrs, text) {\n    var node = document.createElement(tag);\n    Object.keys(attrs || {}).forEach(function (key) {\n      node.setAttribute(key, attrs[key]);\n    });\n    if (text !== undefined) {\n      node.textContent = text;\n    }\n    return node;\n  }\n  // Rebuild both checklists from the selected pack only: nothing from another\n  // pack stays in the form, so nothing from another pack can be submitted.\n  function buildLists() {\n    var option = (packSelect && packData[packSelect.value]) || {\n      agents: [],\n      channels: [],\n      default_channels: []\n    };\n    if (agentList) {\n      agentList.textContent = \"\";\n      option.agents.forEach(function (agent) {\n        var label = el(\"label\", { class: \"checkbox\", \"data-agent\": agent.name });\n        var input = el(\"input\", { type: \"checkbox\", name: \"agents\", value: agent.name });\n        input.checked = true;\n        label.appendChild(input);\n        label.appendChild(document.createTextNode(\" \"));\n        label.appendChild(el(\"span\", {}, agent.name));\n        if (agent.category !== \"active\") {\n          label.appendChild(document.createTextNode(\" \"));\n          label.appendChild(\n            el(\n              \"span\",\n              { class: \"muted\" },\n              \"(\" + (categoryLabels[agent.category] || agent.category) + \")\"\n            )\n          );\n        }\n        agentList.appendChild(label);\n      });\n    }\n    if (channelList) {\n      channelList.textContent = \"\";\n      option.channels.forEach(function (channel) {\n        var label = el(\"label\", { class: \"checkbox channel-row\", \"data-channel\": channel });\n        var input = el(\"input\", { type: \"checkbox\", name: \"channels\", value: channel });\n        input.checked = option.default_channels.indexOf(channel) !== -1;\n        label.appendChild(input);\n        label.appendChild(el(\"span\", { class: \"channel-name\" }, channel));\n        label.appendChild(el(\"span\", { class: \"channel-note muted\" }, channelNotes[channel] || \"\"));\n        channelList.appendChild(label);\n      });\n    }\n    if (agentCount) {\n      agentCount.textContent = String(option.agents.length);\n    }\n    if (channelCount) {\n      channelCount.textContent = String(option.channels.length);\n    }\n  }\n  function applySearch() {\n    if (!agentList) {\n      return;\n    }\n    var term = search ? search.value.trim().toLowerCase() : \"\";\n    Array.prototype.forEach.call(agentList.querySelectorAll(\"label\"), function (label) {\n      label.hidden = term !== \"\" && label.textContent.toLowerCase().indexOf(term) === -1;\n    });\n  }\n  function syncMethod() {\n    var gitSelected = !!(gitRadio && gitRadio.checked);\n    Array.prototype.forEach.call(gitFields, function (field) {\n      field.hidden = !gitSelected;\n    });\n    Array.prototype.forEach.call(apiFields, function (field) {\n      field.hidden = gitSelected;\n      var input = field.querySelector(\"input\");\n      if (input) {\n        input.disabled = gitSelected;\n      }\n    });\n    if (!channelList) {\n      return;\n    }\n    Array.prototype.forEach.call(channelList.querySelectorAll(\"label\"), function (label) {\n      var input = label.querySelector(\"input[type=checkbox]\");\n      if (!input || !apiOnlyValues[input.value]) {\n        return;\n      }\n      var note = label.querySelector(\".channel-note\");\n      var base = channelNotes[input.value] || \"\";\n      if (gitSelected && !input.disabled) {\n        input.dataset.wasChecked = input.checked ? \"1\" : \"0\";\n        input.checked = false;\n        input.disabled = true;\n      } else if (!gitSelected && input.disabled) {\n        input.disabled = false;\n        input.checked = input.dataset.wasChecked === \"1\";\n      }\n      if (note) {\n        note.textContent = gitSelected ? base + unavailableNote : base;\n      }\n      label.classList.toggle(\"channel-api-only\", gitSelected);\n    });\n  }\n  function setAll(list, checked) {\n    if (!list) {\n      return;\n    }\n    Array.prototype.forEach.call(list.querySelectorAll(\"input[type=checkbox]\"), function (input) {\n      if (!input.disabled) {\n        input.checked = checked;\n      }\n    });\n    notifyChanged();\n  }\n  [\n    [\"detect-agents-all\", agentList, true],\n    [\"detect-agents-none\", agentList, false],\n    [\"detect-channels-all\", channelList, true],\n    [\"detect-channels-none\", channelList, false]\n  ].forEach(function (entry) {\n    var button = document.getElementById(entry[0]);\n    if (button) {\n      button.addEventListener(\"click\", function () {\n        setAll(entry[1], entry[2]);\n      });\n    }\n  });\n  if (search) {\n    search.addEventListener(\"input\", applySearch);\n  }\n  Array.prototype.forEach.call(\n    form ? form.querySelectorAll('input[name=\"source\"]') : [],\n    function (radio) {\n      radio.addEventListener(\"change\", syncMethod);\n    }\n  );\n  if (packSelect) {\n    packSelect.addEventListener(\"change\", function () {\n      buildLists();\n      applySearch();\n      syncMethod();\n    });\n  }\n  syncMethod();\n})();\n</script>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

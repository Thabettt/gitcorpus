  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Runs · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\" aria-current=\"page\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h1>Run history</h1>\n    <a class=\"button primary\" href=\"/find\">New find</a>\n  </div>\n  <form id=\"run-filters\" class=\"run-filters\" action=\"/runs\" method=\"get\">\n    <label class=\"field\" for=\"run-filter-status\">\n      <span class=\"field-label\">Status</span>\n      <select class=\"field-input\" id=\"run-filter-status\" name=\"status\">\n        <option value=\"\" selected>any</option>\n        \n        <option value=\"queued\" >Waiting</option>\n        \n        <option value=\"running\" >Running</option>\n        \n        <option value=\"done\" >Finished</option>\n        \n        <option value=\"partial\" >Finished — incomplete</option>\n        \n        <option value=\"failed\" >Failed</option>\n        \n        <option value=\"cancelled\" >Stopped</option>\n        \n      </select>\n    </label>\n    <label class=\"field\" for=\"run-filter-hash\">\n      <span class=\"field-label\">Search ID (exact or prefix)</span>\n      <input class=\"field-input\" type=\"text\" id=\"run-filter-hash\" name=\"hash\" value=\"\">\n    </label>\n    <div class=\"form-actions\">\n      <button class=\"button\" type=\"submit\">Apply</button>\n      <a class=\"button ghost\" href=\"/runs\">Clear</a>\n    </div>\n  </form>\n  \n  <div class=\"table-wrap\">\n    <table id=\"run-history\" class=\"data-table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">Run</th>\n          <th scope=\"col\">ID</th>\n          <th scope=\"col\">Status</th>\n          <th scope=\"col\">Found</th>\n          <th scope=\"col\">Saved</th>\n          <th scope=\"col\">Duration</th>\n          <th scope=\"col\">When</th>\n          <th scope=\"col\">Actions</th>\n        </tr>\n      </thead>\n      <tbody id=\"run-history-body\">\n      \n        <tr id=\"history-run-952\" data-run-id=\"952\" data-status=\"done\">\n          <td><a href=\"/runs/952\">#952</a></td>\n          <td class=\"mono\"><a href=\"/runs/952\" aria-label=\"Open run 952\">golden-d</a></td>\n          <td>\n            <span class=\"pill done\" data-status=\"done\">Finished</span>\n            \n          </td>\n          <td data-count=\"fetched\">1</td>\n          <td data-count=\"inserted\">1</td>\n          <td data-field=\"duration\">—</td>\n          <td><relative-time></td>\n          <td class=\"actions-cell\">\n            <div class=\"actions-row\">\n              <a class=\"button ghost\" href=\"/runs/952\">Detail</a>\n              \n              <form class=\"inline-form\" action=\"/runs/952/replay\" method=\"post\" data-replay=\"true\">\n                <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                <button class=\"button\" type=\"submit\" aria-label=\"Replay run 952\">Replay</button>\n              </form>\n              \n            </div>\n          </td>\n        </tr>\n      \n        <tr id=\"history-run-931\" data-run-id=\"931\" data-status=\"done\">\n          <td><a href=\"/runs/931\">#931</a></td>\n          <td class=\"mono\"><a href=\"/runs/931\" aria-label=\"Open run 931\">c0ffee00</a></td>\n          <td>\n            <span class=\"pill done\" data-status=\"done\">Finished</span>\n            \n          </td>\n          <td data-count=\"fetched\">3</td>\n          <td data-count=\"inserted\">3</td>\n          <td data-field=\"duration\">5m 0s</td>\n          <td><relative-time></td>\n          <td class=\"actions-cell\">\n            <div class=\"actions-row\">\n              <a class=\"button ghost\" href=\"/runs/931\">Detail</a>\n              \n              <form class=\"inline-form\" action=\"/runs/931/replay\" method=\"post\" data-replay=\"true\">\n                <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                <button class=\"button\" type=\"submit\" aria-label=\"Replay run 931\">Replay</button>\n              </form>\n              \n            </div>\n          </td>\n        </tr>\n      \n        <tr id=\"history-run-932\" data-run-id=\"932\" data-status=\"partial\" data-incomplete=\"true\">\n          <td><a href=\"/runs/932\">#932</a></td>\n          <td class=\"mono\"><a href=\"/runs/932\" aria-label=\"Open run 932\">c0ffee00</a></td>\n          <td>\n            <span class=\"pill partial\" data-status=\"partial\">Finished — incomplete</span>\n            <span class=\"badge flag incomplete\" data-flag=\"incomplete\" title=\"Finished but incomplete\">incomplete</span>\n          </td>\n          <td data-count=\"fetched\">2</td>\n          <td data-count=\"inserted\">2</td>\n          <td data-field=\"duration\">4m 0s</td>\n          <td><relative-time></td>\n          <td class=\"actions-cell\">\n            <div class=\"actions-row\">\n              <a class=\"button ghost\" href=\"/runs/932\">Detail</a>\n              \n              <form class=\"inline-form\" action=\"/runs/932/replay\" method=\"post\" data-replay=\"true\">\n                <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                <button class=\"button\" type=\"submit\" aria-label=\"Replay run 932\">Replay</button>\n              </form>\n              \n            </div>\n          </td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n  \n  \n  <nav id=\"runs-pagination\" class=\"pagination\" aria-label=\"Run history pages\">\n    \n    <span id=\"runs-page-status\" class=\"muted\" data-page=\"1\" data-pages=\"1\">Page 1 of 1 · 3 runs</span>\n    \n  </nav>\n</section>\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

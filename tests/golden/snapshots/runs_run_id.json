"—\" ? Date.parse(finished) : null;\n    var el = document.getElementById(\"run-elapsed\");\n    function fmt(seconds) {\n      if (seconds < 60) return Math.round(seconds) + \"s\";\n      var minutes = Math.floor(seconds / 60);\n      var secs = Math.floor(seconds % 60);\n      if (minutes < 60) return minutes + \"m \" + secs + \"s\";\n      var hours = Math.floor(minutes / 60);\n      return hours + \"h \" + (minutes % 60) + \"m\";\n    }\n    function tick() {\n      var now = endMs || Date.now();\n      var seconds = Math.max(0, (now - startMs) / 1000);\n      if (el) el.textContent = \"elapsed \" + fmt(seconds);\n    }\n    tick();\n    if (!endMs) window.__gcRunClock = setInterval(tick, 1000);\n  })();\n  </script>\n</div>\n  <details id=\"run-timestamps\">\n    <summary>Technical details</summary>\n    <div class=\"run-meta\">\n      <span id=\"run-created\" data-field=\"created\">created 2026-01-02T00:00:00Z</span>\n      <span id=\"run-started\" data-field=\"started\">started 2026-01-02T00:00:01Z</span>\n      <span id=\"run-finished\" data-field=\"finished\">finished 2026-01-02T00:05:01Z</span>\n      <span id=\"run-duration\" data-field=\"duration\">duration 5m 0s</span>\n    </div>\n  </details>\n</section>\n<section class=\"panel\" id=\"run-asked-for\">\n  <details>\n    <summary>What this search asked for</summary>\n    <p>Rust</p>\n    <details>\n      <summary>Technical details</summary>\n      <p class=\"mono\">language:rust</p>\n    </details>\n  </details>\n</section>\n<section hx-get=\"/partials/runs/931/quality\" hx-trigger=\"load\" hx-swap=\"outerHTML\">\n  <p>Data quality is loading…</p>\n</section>\n<section class=\"panel\" id=\"run-actions\">\n  <div class=\"form-actions\">\n    <a id=\"detect-agent-use\" class=\"button\" href=\"/runs/931/detect\" title=\"Scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo.\">Detect agent use</a>\n    <a id=\"export-json\" class=\"button\" href=\"/runs/931/export?format=json\">Export JSON</a>\n    <a id=\"export-csv\" class=\"button\" href=\"/runs/931/export?format=csv\">Export CSV</a>\n    <button id=\"clone-open\" class=\"button\" type=\"button\" data-open=\"clone-modal\">Clone code…</button>\n    <button id=\"save-filter-open\" class=\"button\" type=\"button\" data-open=\"save-filter-modal\">Save filter…</button>\n    <button id=\"freeze-open\" class=\"button\" type=\"button\" data-open=\"freeze-modal\">Freeze as corpus…</button>\n    <form id=\"compare-form\" class=\"inline-form\" action=\"/runs/931/diff\" method=\"get\">\n      <label class=\"field\" for=\"compare-against\">\n        <span class=\"field-label\">Compare with…</span>\n        <select class=\"field-input\" id=\"compare-against\" name=\"against\">\n          \n          <option value=\"932\">#932 · Finished — incomplete · <relative-time></option>\n          \n        </select>\n      </label>\n      <button id=\"compare-submit\" class=\"button ghost\" type=\"submit\">Compare</button>\n    </form>\n    <form id=\"replay\" action=\"/runs/931/replay\" method=\"post\">\n      <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n      <button class=\"button primary\" type=\"submit\">Search again</button>\n    </form>\n  </div>\n  \n  \n  <p id=\"detect-agent-use-note\" class=\"muted\">Detect agent use scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo. Latest: <a href=\"/runs/952\">detection #1</a> — 2 agent signal(s).</p>\n  <p class=\"muted\">Export downloads the frozen result list as JSON or CSV. Clone copies repo contents to this machine — no GitHub API calls; uses disk and time. Search again starts a new search with the same filter; the old results stay frozen.</p>\n  <p class=\"muted\">Freeze as corpus records the exact repos and details as of now. No GitHub calls; does not copy code.</p>\n  <p><a href=\"/runs\">All searches</a></p>\n</section>\n<span id=\"table-loading\" class=\"htmx-indicator muted\" role=
"range\" min=\"0\" max=\"3\" value=\"3\" step=\"1\">\n        <input id=\"clone-limit-input\" type=\"number\" min=\"0\" max=\"3\" value=\"3\" step=\"1\" inputmode=\"numeric\" aria-label=\"Repos to clone (number)\">\n      </div>\n      <fieldset class=\"clone-modes\">\n        <legend>Mode</legend>\n        <label><input type=\"radio\" name=\"mode\" value=\"shallow\" checked> shallow — <span class=\"muted\">latest snapshot only</span></label>\n        <label><input type=\"radio\" name=\"mode\" value=\"file_only\"> file only — <span class=\"muted\">no history, smallest disk</span></label>\n        <label><input type=\"radio\" name=\"mode\" value=\"windowed\"> windowed — <span class=\"muted\">recent history, largest disk</span></label>\n      </fieldset>\n    </form>\n    <span id=\"clone-estimate-loading\" class=\"htmx-indicator muted\" role=\"status\">Updating estimate…</span>\n    \n<div id=\"clone-estimate\" class=\"clone-estimate\" data-repos=\"3\" data-estimated-mb=\"0.6\">\n  <p>Repos: <strong id=\"clone-estimate-repos\">3</strong> · estimated <strong id=\"clone-estimate-mb\">0.6</strong> MB</p>\n  \n</div>\n\n    <div class=\"form-actions\">\n      <button id=\"clone-start\" class=\"button primary\" type=\"button\" data-run-id=\"931\">Start clone</button>\n      <button id=\"clone-cancel\" class=\"button\" type=\"button\" data-close=\"clone-modal\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<div id=\"save-filter-modal\" class=\"modal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"save-filter-title\" data-run-id=\"931\">\n  <div class=\"modal-panel\">\n    <div class=\"panel-head\">\n      <h2 id=\"save-filter-title\">Save filter…</h2>\n      <button id=\"save-filter-close\" class=\"button ghost\" type=\"button\" data-close=\"save-filter-modal\" aria-label=\"Close save filter dialog\">Close</button>\n    </div>\n    <p class=\"muted\">Stores this search's filter in your library so you can run it again later.</p>\n    <form id=\"save-filter
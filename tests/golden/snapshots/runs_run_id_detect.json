{
  "path": "/runs/931/detect",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Detect agent use · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\" aria-current=\"page\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"detect-options\" data-run-id=\"931\">\n  <div class=\"panel-head\">\n    <h1>Detect agent use — search #931</h1>\n    <p class=\"muted\">Scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo. It never calls discovery/search endpoints and never copies code.</p>\n  </div>\n  \n  \n  <form id=\"detect-form\" action=\"/runs/931/detect\" method=\"post\">\n    <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n    <label class=\"field\" for=\"detect-pack\">\n      <span class=\"field-label\">Pack version</span>\n      <select class=\"field-input\" id=\"detect-pack\" name=\"pack_version\">\n        <option value=\"golden-pack\">golden-pack</option>\n      </select>\n    </label>\n    <fieldset>\n      <legend>Agents (3)</legend>\n      <p class=\"muted\">Only the selected agents are matched, counted, and exported. Keep all checked to scan for every agent.</p>\n      <div class=\"checklist\" id=\"detect-agents\">\n        \n        <label><input type=\"checkbox\" name=\"agents\" value=\"Claude Code\" checked> Claude Code</label>\n        \n        <label><input type=\"checkbox\" name=\"agents\" value=\"Codex\" checked> Codex</label>\n        \n        <label><input type=\"checkbox\" name=\"agents\" value=\"Generic\" checked> Generic</label>\n        \n      </div>\n    </fieldset>\n    <fieldset>\n      <legend>Channels</legend>\n      <div class=\"checklist\" id=\"detect-channels\">\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"file\" checked> file</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"author\" checked> author</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"branch\" checked> branch</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"label\" checked> label</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"bot\" checked> bot</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"commit_trailer\" checked> commit_trailer</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"pr_metadata\" checked> pr_metadata</label>\n        \n        <label><input type=\"checkbox\" name=\"channels\" value=\"issue\" checked> issue</label>\n        \n      </div>\n    </fieldset>\n    <label class=\"field\" for=\"detect-limit\">\n      <span class=\"field-label\">Top-N repos (blank = all 3)</span>\n      <input class=\"field-input\" id=\"detect-limit\" name=\"limit\" type=\"number\" min=\"1\">\n    </label>\n    <div id=\"detect-estimate\"\n         hx-get=\"/runs/931/detect-estimate\"\n         hx-trigger=\"load, change from:#detect-form\"\n         hx-include=\"#detect-form\"\n         hx-swap=\"outerHTML\">\n      <p class=\"muted\">Estimating…</p>\n    </div>\n    <div class=\"form-actions\">\n      <button id=\"detect-start\" class=\"button primary\" type=\"submit\">Start detection</button>\n      <a class=\"button\" href=\"/runs/931\">Cancel</a>\n    </div>\n  </form>\n  <p class=\"muted\">Depth is windowed: last 100 commits, most recent 100 PRs and issues — labelled as windowed, never presented as a census. Tier boundaries are documented in <code>docs/detection-tiers.md</code>. Detection is an undercount: agents that hide their traces are not visible.</p>\n  <p><a href=\"/detections\">All detections</a></p>\n</section>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

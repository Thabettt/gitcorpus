{
  "path": "/runs/931/detect",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Detect agent use · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\" aria-current=\"page\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"detect-options\" data-run-id=\"931\">\n  <div class=\"panel-head\">\n    <h1>Detect agent use — search #931</h1>\n    <p class=\"muted\">Scans the frozen corpus through GitHub’s API on its own allowance and stores evidence per repo. It never calls discovery/search endpoints and never copies code.</p>\n  </div>\n  \n  \n  <form id=\"detect-form\" action=\"/runs/931/detect\" method=\"post\">\n    <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n    <section class=\"filter-section\" id=\"detect-pack-section\">\n      <h2>Trace pack</h2>\n      <p class=\"muted\">The frozen pattern set used for matching — agent heuristics plus the 63-tool roster. Packs are immutable once frozen, and every stored evidence row carries this version.</p>\n      <div class=\"field-grid\">\n        <label class=\"field\" for=\"detect-pack\">\n          <span class=\"field-label\">Pack version</span>\n          <select class=\"field-input\" id=\"detect-pack\" name=\"pack_version\">\n            <option value=\"golden-pack\">golden-pack</option>\n          </select>\n        </label>\n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-agents-section\">\n      <div class=\"detect-section-head\">\n        <h2>Agents (3)</h2>\n        <div class=\"checklist-tools\">\n          <input type=\"search\" id=\"detect-agent-search\" class=\"field-input checklist-search\" aria-label=\"Search agents\" placeholder=\"Search agents…\">\n          <button type=\"button\" id=\"detect-agents-all\" class=\"button ghost\">Select all</button>\n          <button type=\"button\" id=\"detect-agents-none\" class=\"button ghost\">Select none</button>\n        </div>\n      </div>\n      <p class=\"muted\">Only the selected agents are matched, counted, and exported. Selection narrows matching, not fetching — the same API calls run either way. Keep all checked to scan for every agent.</p>\n      <div class=\"checklist\" id=\"detect-agents\">\n        \n        <label class=\"checkbox\"><input type=\"checkbox\" name=\"agents\" value=\"Claude Code\" checked> <span>Claude Code</span></label>\n        \n        <label class=\"checkbox\"><input type=\"checkbox\" name=\"agents\" value=\"Codex\" checked> <span>Codex</span></label>\n        \n        <label class=\"checkbox\"><input type=\"checkbox\" name=\"agents\" value=\"Generic\" checked> <span>Generic</span></label>\n        \n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-channels-section\">\n      <div class=\"detect-section-head\">\n        <h2>Channels</h2>\n        <div class=\"checklist-tools\">\n          <button type=\"button\" id=\"detect-channels-all\" class=\"button ghost\">Select all</button>\n          <button type=\"button\" id=\"detect-channels-none\" class=\"button ghost\">Select none</button>\n        </div>\n      </div>\n      <p class=\"muted\">Independent heuristics, each run per repo and grouped in the results. Several channels share one API call; the per-repo cost is noted next to each.</p>\n      <div class=\"checklist checklist-channels\" id=\"detect-channels\">\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"file\" checked>\n          <span class=\"channel-name\">file</span>\n          <span class=\"channel-note muted\">Tree + .gitignore + content probes · 2+ REST calls</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"author\" checked>\n          <span class=\"channel-name\">author</span>\n          <span class=\"channel-note muted\">Commit author/committer identities · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"branch\" checked>\n          <span class=\"channel-name\">branch</span>\n          <span class=\"channel-note muted\">PR head branches · shares the PR call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"label\" checked>\n          <span class=\"channel-name\">label</span>\n          <span class=\"channel-note muted\">PR labels · shares the PR call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"bot\" checked>\n          <span class=\"channel-name\">bot</span>\n          <span class=\"channel-note muted\">Generic CI bots, QA evidence only · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"commit_trailer\" checked>\n          <span class=\"channel-name\">commit_trailer</span>\n          <span class=\"channel-note muted\">Co-author / generated-by trailers · shares the history call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"pr_metadata\" checked>\n          <span class=\"channel-name\">pr_metadata</span>\n          <span class=\"channel-note muted\">PR author, body marker, PR→commit propagation · 1 GraphQL call</span>\n        </label>\n        \n        <label class=\"checkbox channel-row\">\n          <input type=\"checkbox\" name=\"channels\" value=\"issue\" checked>\n          <span class=\"channel-name\">issue</span>\n          <span class=\"channel-note muted\">Agent users in issues and PR comments · 1 GraphQL call</span>\n        </label>\n        \n      </div>\n    </section>\n    <section class=\"filter-section\" id=\"detect-scope-section\">\n      <h2>Scope</h2>\n      <p class=\"muted\">Detection walks the frozen result list in star order (most stars first). A top-N limit is useful for pilot runs; the estimate below updates as you change options.</p>\n      <div class=\"field-grid\">\n        <label class=\"field\" for=\"detect-limit\">\n          <span class=\"field-label\">Top-N repos</span>\n          <input class=\"field-input\" id=\"detect-limit\" name=\"limit\" type=\"number\" min=\"1\" placeholder=\"All 3\">\n          <span class=\"field-note muted\">Blank = all 3 frozen repos.</span>\n        </label>\n      </div>\n      <div id=\"detect-estimate\"\n           hx-get=\"/runs/931/detect-estimate\"\n           hx-trigger=\"load, change from:#detect-form\"\n           hx-include=\"#detect-form\"\n           hx-swap=\"outerHTML\">\n        <p class=\"muted\">Estimating…</p>\n      </div>\n    </section>\n    <div class=\"form-actions\">\n      <button id=\"detect-start\" class=\"button primary\" type=\"submit\">Start detection</button>\n      <a class=\"button\" href=\"/runs/931\">Cancel</a>\n    </div>\n    <p class=\"muted\">Starts a detect run on its own GitHub allowance. Progress, cancel, and resume work like any other run, and results land on the run’s detection page.</p>\n  </form>\n  <p class=\"muted\">Depth is windowed: last 100 commits, most recent 100 PRs and issues — labelled as windowed, never presented as a census. Tier boundaries are documented in <code>docs/detection-tiers.md</code>. Detection is an undercount: agents that hide their traces are not visible.</p>\n  <p><a href=\"/detections\">All detections</a></p>\n</section>\n<script>\n(function () {\n  \"use strict\";\n  var form = document.getElementById(\"detect-form\");\n  function notifyChanged() {\n    if (form) {\n      form.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    }\n  }\n  if (form) {\n    form.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Enter\" && event.target.type !== \"submit\") {\n        event.preventDefault();\n      }\n    });\n  }\n  var agentLabels = [];\n  function wireGroup(listId, allId, noneId) {\n    var list = document.getElementById(listId);\n    if (!list) {\n      return [];\n    }\n    var labels = Array.prototype.slice.call(list.querySelectorAll(\"label\"));\n    function setAll(checked) {\n      labels.forEach(function (label) {\n        label.querySelector(\"input[type=checkbox]\").checked = checked;\n      });\n      notifyChanged();\n    }\n    var selectAll = document.getElementById(allId);\n    var selectNone = document.getElementById(noneId);\n    if (selectAll) {\n      selectAll.addEventListener(\"click\", function () {\n        setAll(true);\n      });\n    }\n    if (selectNone) {\n      selectNone.addEventListener(\"click\", function () {\n        setAll(false);\n      });\n    }\n    return labels;\n  }\n  agentLabels = wireGroup(\"detect-agents\", \"detect-agents-all\", \"detect-agents-none\");\n  wireGroup(\"detect-channels\", \"detect-channels-all\", \"detect-channels-none\");\n  var search = document.getElementById(\"detect-agent-search\");\n  if (search) {\n    search.addEventListener(\"input\", function () {\n      var term = search.value.trim().toLowerCase();\n      agentLabels.forEach(function (label) {\n        label.hidden = term !== \"\" && label.textContent.toLowerCase().indexOf(term) === -1;\n      });\n    });\n  }\n})();\n</script>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

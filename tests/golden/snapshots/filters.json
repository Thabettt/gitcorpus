  "path": "/filters",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Library · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\" aria-current=\"page\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h1>Library</h1>\n    <a class=\"button primary\" href=\"/find\">New search</a>\n  </div>\n  <p class=\"muted\" id=\"library-framing\">A saved filter is the recipe for a search. Running it again searches GitHub live; frozen results stay with each Search.</p>\n  \n  <div class=\"table-wrap\">\n    <table id=\"library-table\" class=\"data-table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">Name</th>\n          <th scope=\"col\">Filter in plain words</th>\n          <th scope=\"col\">Last used</th>\n          <th scope=\"col\">Actions</th>\n        </tr>\n      </thead>\n      <tbody id=\"library-body\">\n      \n        <tr id=\"saved-filter-921\" data-filter-id=\"921\" data-filter-hash=\"4a08a9ed4365b4801cea33f107ed2a4485aaeae2a59b196ee8c9473db378f0d1\">\n          <td>\n            <span class=\"library-name\" title=\"4a08a9ed4365b4801cea33f107ed2a4485aaeae2a59b196ee8c9473db378f0d1\">rust picks</span>\n          </td>\n          <td class=\"library-sentence\">Rust</td>\n          <td class=\"library-last-used\">\n            \n            <span class=\"muted\" data-no-run=\"true\">never</span>\n            \n          </td>\n          <td class=\"actions-cell\">\n            <div class=\"actions-row\">\n              <form class=\"inline-form\" action=\"/filters/921/run\" method=\"post\">\n                <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                <button class=\"button primary\" type=\"submit\"\n                        title=\"Finds matching repos now, saves their details, applies file and country rules, and freezes the results. Uses your GitHub allowance; can take minutes.\">Run now</button>\n              </form>\n              <a class=\"button ghost\" href=\"/find?filter=921\"\n                 title=\"Loads this filter into the search form. No GitHub calls.\">Open in editor</a>\n              <details class=\"inline-details\">\n                <summary class=\"button\" title=\"Changes the recipe’s name only.\">Rename</summary>\n                <form class=\"inline-form\" action=\"/filters/921/rename\" method=\"post\">\n                  <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                  <label class=\"sr-only\" for=\"rename-921\">Rename rust picks</label>\n                  <input class=\"inline-input\" type=\"text\" id=\"rename-921\" name=\"name\" value=\"rust picks\" aria-label=\"New name for rust picks\">\n                  <button class=\"button\" type=\"submit\">Save name</button>\n                </form>\n              </details>\n              <button class=\"button danger\" type=\"button\" data-open=\"delete-filter-921\"\n                      data-delete-filter data-name=\"rust picks\"\n                      aria-label=\"Delete rust picks\"\n                      title=\"Removes the recipe only; Searches and Corpora are untouched.\">Delete</button>\n              <noscript>\n                <form class=\"inline-form\" action=\"/filters/921/delete\" method=\"post\">\n                  <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n                  <button class=\"button danger\" type=\"submit\" aria-label=\"Delete rust picks\">Delete</button>\n                </form>\n              </noscript>\n            </div>\n          </td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n  \n  <p class=\"muted\" id=\"library-action-help\">Run now finds matching repos now, saves their details, applies file and country rules, and freezes the results. Uses your GitHub allowance; can take minutes. Open in editor loads the filter into the search form with no GitHub calls. Rename changes the recipe’s name only. Delete removes the recipe only; Searches and Corpora are untouched.</p>\n  \n  \n</section>\n\n<div id=\"delete-filter-921\" class=\"modal\" role=\"dialog\" aria-modal=\"true\"\n     aria-labelledby=\"delete-filter-921-title\" hidden>\n  <div class=\"modal-panel\">\n    <div class=\"panel-head\">\n      <h2 id=\"delete-filter-921-title\">Delete “rust picks”?</h2>\n      <button class=\"button ghost\" type=\"button\" data-close=\"delete-filter-921\"\n              aria-label=\"Keep rust picks\">Close</button>\n    </div>\n    <p>This removes the recipe only; Searches and Corpora are untouched.</p>\n    <form action=\"/filters/921/delete\" method=\"post\">\n      <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n      <div class=\"form-actions\">\n        <button class=\"button danger\" type=\"submit\">Delete recipe</button>\n        <button class=\"button\" type=\"button\" data-close=\"delete-filter-921\">Cancel</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

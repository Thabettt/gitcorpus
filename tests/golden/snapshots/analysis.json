{
  "path": "/analysis",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Analysis · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n    <a href=\"/analysis\" aria-current=\"page\">Analysis</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel analysis-intro\" id=\"analysis-header\">\n  <div class=\"panel-head\">\n    <div>\n      <h1>Analysis</h1>\n      <p class=\"muted\">Pick a finished detection run, then choose what to measure. Everything is computed locally from stored detection evidence, repository metadata, and owner countries.</p>\n    </div>\n  </div>\n\n  \n  <form id=\"analysis-picker\" class=\"analysis-picker\" method=\"get\" action=\"/analysis\">\n    <input type=\"hidden\" name=\"metrics_present\" value=\"1\">\n    <div class=\"analysis-picker-row\">\n      <label class=\"field\" for=\"analysis-run\">\n        <span class=\"field-label\">Detection run</span>\n        <select class=\"field-input\" id=\"analysis-run\" name=\"run\" required>\n          \n          <option value=\"952\">#1 · search #931 · done · 1 repos · 2026-01-02 00:06</option>\n          \n        </select>\n      </label>\n    </div>\n\n    <fieldset id=\"analysis-metrics\" class=\"metric-picker\">\n      <legend class=\"field-label\">What to analyze</legend>\n      <div class=\"metric-grid\">\n        \n        <label class=\"metric-option\" for=\"analysis-metric-agent_share\">\n          <input type=\"checkbox\" id=\"analysis-metric-agent_share\" name=\"metric\" value=\"agent_share\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Agent share</span>\n            <span class=\"metric-option-desc\">Repos with each agent, as a share of every scanned repo and of readable repos.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-agents_by_country\">\n          <input type=\"checkbox\" id=\"analysis-metric-agents_by_country\" name=\"metric\" value=\"agents_by_country\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Agents by country</span>\n            <span class=\"metric-option-desc\">Repo counts per country and agent. Unknown country is its own bucket.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-adoption\">\n          <input type=\"checkbox\" id=\"analysis-metric-adoption\" name=\"metric\" value=\"adoption\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Agent use</span>\n            <span class=\"metric-option-desc\">Share of repos with at least one agent, plus the adoption-level mix.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-adoption_by_country\">\n          <input type=\"checkbox\" id=\"analysis-metric-adoption_by_country\" name=\"metric\" value=\"adoption_by_country\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Agent use by country</span>\n            <span class=\"metric-option-desc\">Adoption rate per country, repo-weighted. Unknown country is its own bucket.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-size_vs_adoption\">\n          <input type=\"checkbox\" id=\"analysis-metric-size_vs_adoption\" name=\"metric\" value=\"size_vs_adoption\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Repo size vs agent use</span>\n            <span class=\"metric-option-desc\">Adoption rate by repository size bucket, with per-agent rates.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-agent_debut\">\n          <input type=\"checkbox\" id=\"analysis-metric-agent_debut\" name=\"metric\" value=\"agent_debut\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Agent debuts</span>\n            <span class=\"metric-option-desc\">Earliest observed signal per agent, plus the earliest repo that carries it.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-fingerprint_debut\">\n          <input type=\"checkbox\" id=\"analysis-metric-fingerprint_debut\" name=\"metric\" value=\"fingerprint_debut\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Fingerprint debuts</span>\n            <span class=\"metric-option-desc\">Earliest observed signal for the top file, branch, trailer, author, label, and issue fingerprints per agent.</span>\n          </span>\n        </label>\n        \n        <label class=\"metric-option\" for=\"analysis-metric-country_wealth\">\n          <input type=\"checkbox\" id=\"analysis-metric-country_wealth\" name=\"metric\" value=\"country_wealth\" checked>\n          <span class=\"metric-option-copy\">\n            <span class=\"metric-option-title\">Country wealth vs agent use</span>\n            <span class=\"metric-option-desc\">GDP per capita and income group against adoption rate.</span>\n          </span>\n        </label>\n        \n      </div>\n    </fieldset>\n\n    <div class=\"analysis-picker-actions\">\n      <button class=\"button primary\" type=\"submit\" id=\"analysis-open\">Open analysis</button>\n      <span class=\"muted\">Nothing selected opens the report with no sections; you can change the selection inside the report.</span>\n    </div>\n  </form>\n  \n\n  \n  <div class=\"analysis-recent\">\n    <div class=\"panel-head\">\n      <h2>Finished detections</h2>\n      <p class=\"muted\">1 run</p>\n    </div>\n    <div class=\"table-scroll sticky-head analysis-detect-list\">\n      <table id=\"analysis-detections\" class=\"data-table\">\n        <thead>\n          <tr><th scope=\"col\">Detection</th><th scope=\"col\">From search</th><th scope=\"col\">Status</th><th scope=\"col\" class=\"num\">Repos</th><th scope=\"col\">Started</th><th scope=\"col\">Duration</th></tr>\n        </thead>\n        <tbody>\n        \n          <tr id=\"analysis-detection-952\">\n            <td><a href=\"/analysis/952\">#1</a></td>\n            <td><a href=\"/runs/931\">#931</a></td>\n            <td><span class=\"pill done\">Finished</span></td>\n            <td class=\"num\">1</td>\n            <td>2026-01-02 00:06</td>\n            <td>1m 0s</td>\n          </tr>\n        \n        </tbody>\n      </table>\n    </div>\n  </div>\n  \n\n  \n</section>\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

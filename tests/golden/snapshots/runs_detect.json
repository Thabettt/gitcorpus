  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Detection 952 · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\" aria-current=\"page\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n\n<section class=\"panel\" id=\"run-header\" data-run-id=\"952\">\n  <div class=\"panel-head\">\n    <h1>Detection #952 — search #931</h1>\n    <span class=\"run-hash-wrap\"><span class=\"mono\" data-hash=\"golden-detect\">golden-d</span></span>\n  </div>\n  <div id=\"detect-status\">\n  <p class=\"run-status-line\">\n    <span class=\"status-pill status-done\">Finished</span>\n    \n    \n  </p>\n  \n  \n</div>\n</section>\n<section class=\"panel\" id=\"detection-summary\">\n  <div class=\"panel-head\"><h2>Summary</h2></div>\n  <div class=\"cards\">\n    <div class=\"card\"><span class=\"muted\">Repos scanned</span><strong>1</strong></div>\n    <div class=\"card\"><span class=\"muted\">With any signal</span><strong>1</strong></div>\n    <div class=\"card\"><span class=\"muted\">Unavailable</span><strong>0</strong></div>\n    <div class=\"card\"><span class=\"muted\">Windowed commit ratio</span><strong>1.0</strong> <span class=\"muted\">pervasive</span></div>\n    <div class=\"card\"><span class=\"muted\">Pack</span><strong>golden-pack</strong></div>\n    <div class=\"card\"><span class=\"muted\">First signal</span><strong>2026-01-02T00:00:00Z</strong></div>\n  </div>\n  \n  <p id=\"detection-agents\"><span class=\"chip\">Codex · 1</span> <span class=\"chip\">Claude Code · 1</span> </p>\n  \n  \n  <p class=\"muted\">Depth: 100 commits · 100 PRs · 100 issues (windowed). Papers’ baseline: ~0.5–1% false positives, ~3% borderline; detection is an undercount.</p>\n</section>\n<section class=\"panel\" id=\"detection-evidence\">\n  <div class=\"panel-head\">\n    <h2>Per-repo evidence</h2>\n    <div class=\"form-actions\">\n      <a id=\"detection-export\" class=\"button\" href=\"/runs/952/export?format=detections\">Export evidence CSV</a>\n      <a class=\"button\" href=\"/runs/952/export?format=json\">Export JSON</a>\n      <a class=\"button\" href=\"/runs/952/export?format=csv\">Export CSV</a>\n    </div>\n  </div>\n  <div class=\"form-actions\" id=\"detection-filters\">\n    <label class=\"field\" for=\"detection-filter-signal\">\n      <span class=\"field-label\">Has signal</span>\n      <input type=\"checkbox\" id=\"detection-filter-signal\">\n    </label>\n    <label class=\"field\" for=\"detection-filter-agent\">\n      <span class=\"field-label\">Agent</span>\n      <select class=\"field-input\" id=\"detection-filter-agent\">\n        <option value=\"\">All agents</option>\n        <option value=\"Claude Code\">Claude Code</option>\n      </select>\n    </label>\n    <label class=\"field\" for=\"detection-filter-channel\">\n      <span class=\"field-label\">Channel</span>\n      <select class=\"field-input\" id=\"detection-filter-channel\">\n        <option value=\"\">All channels</option>\n        <option value=\"file\">file</option><option value=\"pr_metadata\">pr_metadata</option>\n      </select>\n    </label>\n  </div>\n  \n  <details id=\"detection-repo-911\" data-agents=\"Claude Code\" data-channels=\"file|pr_metadata\">\n    <summary>octo/alpha · Claude Code</summary>\n    \n    \n      \n      <h4>file</h4>\n      <ul>\n        <li><strong>Claude Code</strong> — CLAUDE.md</li>\n      </ul>\n      \n    \n      \n      <h4>pr_metadata</h4>\n      <ul>\n        <li><strong>Codex</strong> — PR #7 → commit a1</li>\n      </ul>\n      \n    \n  </details>\n  \n  \n</section>\n<script>\n(function () {\n  \"use strict\";\n  var signal = document.getElementById(\"detection-filter-signal\");\n  var agent = document.getElementById(\"detection-filter-agent\");\n  var channel = document.getElementById(\"detection-filter-channel\");\n  if (!signal || !agent || !channel) {\n    return;\n  }\n  var repos = Array.prototype.slice.call(\n    document.querySelectorAll(\"#detection-evidence details\")\n  );\n  function values(repo, name) {\n    var raw = repo.getAttribute(name) || \"\";\n    return raw === \"\" ? [] : raw.split(\"|\");\n  }\n  function apply() {\n    var wantSignal = signal.checked;\n    var wantAgent = agent.value;\n    var wantChannel = channel.value;\n    repos.forEach(function (repo) {\n      var agents = values(repo, \"data-agents\");\n      var channels = values(repo, \"data-channels\");\n      var visible =\n        (!wantSignal || agents.length > 0) &&\n        (!wantAgent || agents.indexOf(wantAgent) !== -1) &&\n        (!wantChannel || channels.indexOf(wantChannel) !== -1);\n      repo.hidden = !visible;\n    });\n  }\n  signal.addEventListener(\"change\", apply);\n  agent.addEventListener(\"change\", apply);\n  channel.addEventListener(\"change\", apply);\n})();\n</script>\n\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}

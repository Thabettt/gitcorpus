{
  "path": "/find",
  "status": 200,
  "headers": {
    "content-type": "text/html; charset=utf-8"
  },
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23141518'/%3E%3Crect x='5' y='5' width='6' height='6' rx='1' fill='%232dd4bf'/%3E%3C/svg%3E\">\n<title>Find · gitcorpus</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcorpus</a>\n  \n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Home</a>\n    <a href=\"/runs\">Searches</a>\n    <a href=\"/corpora\">Corpora</a>\n    <a href=\"/filters\">Library</a>\n    <a href=\"/system\">System</a>\n    <a href=\"/detections\">Detections</a>\n  </nav>\n  <a class=\"status-link\" href=\"/system\" aria-label=\"System status\"><span hx-get=\"/partials/status-dot\" hx-trigger=\"load, every 30s\" hx-swap=\"outerHTML\"></span></a>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h1>New search</h1>\n    <p class=\"muted\">Pick filters and run the search; GitHub evaluates the query, extra rules run after fetching.</p>\n  </div>\n  <div id=\"recent-filters\" class=\"recent-filters\" hidden>\n    <span class=\"field-label\" id=\"recent-filters-label\">Recent filters</span>\n    <ul id=\"recent-filters-list\" aria-labelledby=\"recent-filters-label\"></ul>\n  </div>\n  \n  <form id=\"find-form\" class=\"filter-form\" action=\"/find\" method=\"post\" enctype=\"multipart/form-data\">\n    <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n    <aside class=\"summary-rail\" id=\"find-summary\" aria-label=\"Search summary\">\n      <div class=\"summary-rail-block\">\n        <span class=\"field-label\">Your search</span>\n        <p id=\"spec-sentence\" class=\"spec-sentence\">Everything</p>\n      </div>\n      <div class=\"summary-rail-block\">\n        <button class=\"button\" type=\"button\" id=\"check-matches\" hx-get=\"/partials/find/matches\" hx-include=\"closest form\" hx-target=\"#match-result\" hx-swap=\"innerHTML\">Check matches</button>\n        <p class=\"muted\">One search request. Approximate count of repos GitHub can evaluate; extra rules (files, country) will shrink this when you run.</p>\n        <div id=\"match-result\" aria-live=\"polite\"></div>\n      </div>\n      <div class=\"summary-rail-block\">\n        <div class=\"action-row\">\n          <button class=\"button primary\" type=\"submit\" name=\"action\" value=\"find\">Run search (live)</button>\n          <p class=\"muted\">Finds matching repos now, saves their details, applies file and country rules, and freezes the results. Uses your GitHub allowance; can take minutes.</p>\n        </div>\n        <div class=\"action-row\">\n          <label class=\"field\" for=\"field-name\">\n  <span class=\"field-label\">Filter name (Save to library)</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-name\" name=\"name\" value=\"\">\n</label>\n          <button class=\"button\" type=\"submit\" name=\"action\" value=\"save\">Save to library</button>\n          <p class=\"muted\">Keeps this filter on this machine for reuse. No GitHub calls.</p>\n        </div>\n        <div class=\"action-row\">\n          <button class=\"button\" type=\"submit\" name=\"action\" value=\"download\">Download file</button>\n          <p class=\"muted\">Exports this filter as a portable JSON file. No GitHub calls.</p>\n        </div>\n      </div>\n    </aside>\n    <details class=\"filter-section\" id=\"filter-controls\">\n      <summary>Use a filter file</summary>\n      <div class=\"field-grid\">\n        <label class=\"field\" for=\"field-spec-file\">\n          <span class=\"field-label\">Filter file (JSON)</span>\n          <input class=\"field-input\" type=\"file\" id=\"field-spec-file\" name=\"spec_file\" accept=\"application/json\">\n        </label>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"button\" type=\"submit\" name=\"action\" value=\"upload\">Upload and run</button>\n        <p class=\"muted\">Runs the uploaded filter file. Uses your GitHub allowance.</p>\n      </div>\n    </details>\n    <section class=\"filter-section\" id=\"filter-common\">\n      <h2>Common</h2>\n      <p class=\"muted\">These limit which repos match. GitHub evaluates the first part; extra rules run after fetching.</p>\n      <div id=\"filter-keywords\">\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-keywords\">\n  <span class=\"field-label\">Keywords</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-keywords\" name=\"keywords\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-language\">\n  <span class=\"field-label\">Language</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-language\" name=\"language\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-min_stars\">\n  <span class=\"field-label\">Minimum stars</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-min_stars\" name=\"min_stars\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-pushed_from\">\n  <span class=\"field-label\">Updated since</span>\n  <input class=\"field-input\" type=\"date\" id=\"field-pushed_from\" name=\"pushed_from\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-fork\">\n            <span class=\"field-label\">Include forks</span>\n            <select class=\"field-input\" id=\"field-fork\" name=\"fork\">\n              <option value=\"omit\" selected>no forks</option>\n              <option value=\"include\" >include forks</option>\n              <option value=\"only\" >forks only</option>\n            </select>\n          </label>\n        </div>\n        <fieldset class=\"field-group\">\n          <legend class=\"field-label\">In scope</legend>\n          \n          <label class=\"checkbox\" for=\"field-in-scope-name\">\n            <input type=\"checkbox\" id=\"field-in-scope-name\" name=\"in_scope\" value=\"name\" >\n            name\n          </label>\n          \n          <label class=\"checkbox\" for=\"field-in-scope-description\">\n            <input type=\"checkbox\" id=\"field-in-scope-description\" name=\"in_scope\" value=\"description\" >\n            description\n          </label>\n          \n          <label class=\"checkbox\" for=\"field-in-scope-topics\">\n            <input type=\"checkbox\" id=\"field-in-scope-topics\" name=\"in_scope\" value=\"topics\" >\n            topics\n          </label>\n          \n          <label class=\"checkbox\" for=\"field-in-scope-readme\">\n            <input type=\"checkbox\" id=\"field-in-scope-readme\" name=\"in_scope\" value=\"readme\" >\n            readme\n          </label>\n          \n        </fieldset>\n      </div>\n    </section>\n    <details class=\"advanced-filters\">\n      <summary>Advanced</summary>\n      <p class=\"muted\">These limit which repos match. GitHub evaluates the first part; extra rules run after fetching.</p>\n      <section class=\"filter-section\" id=\"filter-owner\">\n        <h2>Owner</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-user\">\n  <span class=\"field-label\">User</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-user\" name=\"user\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-org\">\n  <span class=\"field-label\">Org</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-org\" name=\"org\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-repo\">\n  <span class=\"field-label\">Repo</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-repo\" name=\"repo\" value=\"\">\n</label>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-counts\">\n        <h2>Counts</h2>\n        <div class=\"field-grid\">\n          <fieldset class=\"count-row\" data-count-row>\n  <legend class=\"field-label\">Stars</legend>\n  <select class=\"field-input\" id=\"field-cmp-stars\" name=\"cmp_stars\" data-count-comparator>\n    <option value=\">\" selected>&gt;</option>\n    <option value=\">=\" >&gt;=</option>\n    <option value=\"<\" >&lt;</option>\n    <option value=\"<=\" >&lt;=</option>\n    <option value=\"=\" >=</option>\n    <option value=\"eq\" >eq</option>\n    <option value=\"range\" >range</option>\n  </select>\n  <input class=\"field-input\" type=\"text\" id=\"field-val-stars\" name=\"val_stars\" value=\"\" aria-label=\"Value\" data-count-mode=\"value\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-stars-min\" name=\"range_stars_min\" value=\"\" aria-label=\"Minimum\" data-count-mode=\"range\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-stars-max\" name=\"range_stars_max\" value=\"\" aria-label=\"Maximum\" data-count-mode=\"range\">\n</fieldset>\n          <fieldset class=\"count-row\" data-count-row>\n  <legend class=\"field-label\">Forks</legend>\n  <select class=\"field-input\" id=\"field-cmp-forks\" name=\"cmp_forks\" data-count-comparator>\n    <option value=\">\" selected>&gt;</option>\n    <option value=\">=\" >&gt;=</option>\n    <option value=\"<\" >&lt;</option>\n    <option value=\"<=\" >&lt;=</option>\n    <option value=\"=\" >=</option>\n    <option value=\"eq\" >eq</option>\n    <option value=\"range\" >range</option>\n  </select>\n  <input class=\"field-input\" type=\"text\" id=\"field-val-forks\" name=\"val_forks\" value=\"\" aria-label=\"Value\" data-count-mode=\"value\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-forks-min\" name=\"range_forks_min\" value=\"\" aria-label=\"Minimum\" data-count-mode=\"range\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-forks-max\" name=\"range_forks_max\" value=\"\" aria-label=\"Maximum\" data-count-mode=\"range\">\n</fieldset>\n          <fieldset class=\"count-row\" data-count-row>\n  <legend class=\"field-label\">Size (KB)</legend>\n  <select class=\"field-input\" id=\"field-cmp-size\" name=\"cmp_size\" data-count-comparator>\n    <option value=\">\" selected>&gt;</option>\n    <option value=\">=\" >&gt;=</option>\n    <option value=\"<\" >&lt;</option>\n    <option value=\"<=\" >&lt;=</option>\n    <option value=\"=\" >=</option>\n    <option value=\"eq\" >eq</option>\n    <option value=\"range\" >range</option>\n  </select>\n  <input class=\"field-input\" type=\"text\" id=\"field-val-size\" name=\"val_size\" value=\"\" aria-label=\"Value\" data-count-mode=\"value\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-size-min\" name=\"range_size_min\" value=\"\" aria-label=\"Minimum\" data-count-mode=\"range\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-size-max\" name=\"range_size_max\" value=\"\" aria-label=\"Maximum\" data-count-mode=\"range\">\n</fieldset>\n          <fieldset class=\"count-row\" data-count-row>\n  <legend class=\"field-label\">Followers</legend>\n  <select class=\"field-input\" id=\"field-cmp-followers\" name=\"cmp_followers\" data-count-comparator>\n    <option value=\">\" selected>&gt;</option>\n    <option value=\">=\" >&gt;=</option>\n    <option value=\"<\" >&lt;</option>\n    <option value=\"<=\" >&lt;=</option>\n    <option value=\"=\" >=</option>\n    <option value=\"eq\" >eq</option>\n    <option value=\"range\" >range</option>\n  </select>\n  <input class=\"field-input\" type=\"text\" id=\"field-val-followers\" name=\"val_followers\" value=\"\" aria-label=\"Value\" data-count-mode=\"value\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-followers-min\" name=\"range_followers_min\" value=\"\" aria-label=\"Minimum\" data-count-mode=\"range\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-followers-max\" name=\"range_followers_max\" value=\"\" aria-label=\"Maximum\" data-count-mode=\"range\">\n</fieldset>\n          <fieldset class=\"count-row\" data-count-row>\n  <legend class=\"field-label\">Topics count</legend>\n  <select class=\"field-input\" id=\"field-cmp-topics\" name=\"cmp_topics\" data-count-comparator>\n    <option value=\">\" selected>&gt;</option>\n    <option value=\">=\" >&gt;=</option>\n    <option value=\"<\" >&lt;</option>\n    <option value=\"<=\" >&lt;=</option>\n    <option value=\"=\" >=</option>\n    <option value=\"eq\" >eq</option>\n    <option value=\"range\" >range</option>\n  </select>\n  <input class=\"field-input\" type=\"text\" id=\"field-val-topics\" name=\"val_topics\" value=\"\" aria-label=\"Value\" data-count-mode=\"value\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-topics-min\" name=\"range_topics_min\" value=\"\" aria-label=\"Minimum\" data-count-mode=\"range\">\n  <input class=\"field-input\" type=\"text\" id=\"field-range-topics-max\" name=\"range_topics_max\" value=\"\" aria-label=\"Maximum\" data-count-mode=\"range\">\n</fieldset>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-dates\">\n        <h2>Dates</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-created_from\">\n  <span class=\"field-label\">Created from</span>\n  <input class=\"field-input\" type=\"date\" id=\"field-created_from\" name=\"created_from\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-created_to\">\n  <span class=\"field-label\">Created to</span>\n  <input class=\"field-input\" type=\"date\" id=\"field-created_to\" name=\"created_to\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-pushed_to\">\n  <span class=\"field-label\">Updated before</span>\n  <input class=\"field-input\" type=\"date\" id=\"field-pushed_to\" name=\"pushed_to\" value=\"\">\n</label>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-meta\">\n        <h2>Meta</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-topic\">\n  <span class=\"field-label\">Topic</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-topic\" name=\"topic\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-license\">\n  <span class=\"field-label\">License</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-license\" name=\"license\" value=\"\">\n</label>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-flags\">\n        <h2>Flags</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-archived\">\n  <span class=\"field-label\">Archived</span>\n  <select class=\"field-input\" id=\"field-archived\" name=\"archived\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-mirror\">\n  <span class=\"field-label\">Mirror</span>\n  <select class=\"field-input\" id=\"field-mirror\" name=\"mirror\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-template\">\n  <span class=\"field-label\">Template</span>\n  <select class=\"field-input\" id=\"field-template\" name=\"template\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-visibility\">\n            <span class=\"field-label\">Visibility</span>\n            <select class=\"field-input\" id=\"field-visibility\" name=\"visibility\">\n              <option value=\"any\" selected>any</option>\n              <option value=\"public\" >public</option>\n              <option value=\"private\" >private</option>\n              <option value=\"internal\" >internal</option>\n            </select>\n          </label>\n          <label class=\"field\" for=\"field-sponsorable\">\n  <span class=\"field-label\">Sponsorable</span>\n  <select class=\"field-input\" id=\"field-sponsorable\" name=\"sponsorable\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-funding_file\">\n  <span class=\"field-label\">Funding file</span>\n  <select class=\"field-input\" id=\"field-funding_file\" name=\"funding_file\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-good_first_min\">\n  <span class=\"field-label\">Good first issues min</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-good_first_min\" name=\"good_first_min\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-help_wanted_min\">\n  <span class=\"field-label\">Help wanted issues min</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-help_wanted_min\" name=\"help_wanted_min\" value=\"\">\n</label>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-props-section\">\n        <fieldset id=\"filter-props\" class=\"field-group\" data-props-enabled=\"false\" disabled>\n          <legend class=\"field-label\">Custom properties (single org only)</legend>\n          <div class=\"field-grid\">\n            <label class=\"field\" for=\"field-props-name\">\n              <span class=\"field-label\">Property name</span>\n              <input class=\"field-input\" type=\"text\" id=\"field-props-name\" name=\"props_name\" value=\"\">\n            </label>\n            <label class=\"field\" for=\"field-props-value\">\n              <span class=\"field-label\">Property value</span>\n              <input class=\"field-input\" type=\"text\" id=\"field-props-value\" name=\"props_value\" value=\"\">\n            </label>\n          </div>\n        </fieldset>\n      </section>\n      <section class=\"filter-section\" id=\"filter-virtuals\">\n        <h2>Extra rules</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-team_topic\">\n  <span class=\"field-label\">Team topic</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-team_topic\" name=\"team_topic\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-has_dockerfile\">\n  <span class=\"field-label\">Has Dockerfile</span>\n  <select class=\"field-input\" id=\"field-has_dockerfile\" name=\"has_dockerfile\">\n    <option value=\"any\" selected>any</option>\n    <option value=\"true\" >true</option>\n    <option value=\"false\" >false</option>\n  </select>\n</label>\n          <label class=\"field\" for=\"field-owner_country\">\n  <span class=\"field-label\">Owner country (ISO2)</span>\n  <input class=\"field-input\" type=\"text\" id=\"field-owner_country\" name=\"owner_country\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-min-geo-confidence\">\n            <span class=\"field-label\">Min geo confidence</span>\n            <select class=\"field-input\" id=\"field-min-geo-confidence\" name=\"min_geo_confidence\">\n              <option value=\"\" selected>any</option>\n              <option value=\"exact-iso\" >exact-iso</option>\n              <option value=\"name\" >name</option>\n              <option value=\"gazetteer-city\" >gazetteer-city</option>\n              <option value=\"geocoder\" >geocoder</option>\n              <option value=\"weak\" >weak</option>\n            </select>\n          </label>\n          <label class=\"field\" for=\"field-min_commits\">\n  <span class=\"field-label\">Min commits</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-min_commits\" name=\"min_commits\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-max_commits\">\n  <span class=\"field-label\">Max commits</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-max_commits\" name=\"max_commits\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-min_language_bytes\">\n  <span class=\"field-label\">Min language bytes</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-min_language_bytes\" name=\"min_language_bytes\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-max_language_bytes\">\n  <span class=\"field-label\">Max language bytes</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-max_language_bytes\" name=\"max_language_bytes\" value=\"\">\n</label>\n          <div class=\"field-pair\" role=\"group\" aria-label=\"Lines of code range\">\n            <label class=\"field\" for=\"field-min_loc\">\n  <span class=\"field-label\">Min LOC</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-min_loc\" name=\"min_loc\" value=\"\" disabled aria-describedby=\"field-note-min_loc\">\n  <span class=\"field-note muted\" id=\"field-note-min_loc\">Not available yet — needs full-history analysis (planned)</span>\n</label>\n            <label class=\"field\" for=\"field-max_loc\">\n  <span class=\"field-label\">Max LOC</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-max_loc\" name=\"max_loc\" value=\"\" disabled aria-describedby=\"field-note-max_loc\">\n  <span class=\"field-note muted\" id=\"field-note-max_loc\">Not available yet — needs full-history analysis (planned)</span>\n</label>\n          </div>\n        </div>\n      </section>\n      <section class=\"filter-section\" id=\"filter-result\">\n        <h2>Result</h2>\n        <div class=\"field-grid\">\n          <label class=\"field\" for=\"field-sort\">\n            <span class=\"field-label\">Sort</span>\n            <select class=\"field-input\" id=\"field-sort\" name=\"sort\">\n              <option value=\"\" selected>best match</option>\n              <option value=\"stars\" >stars</option>\n              <option value=\"forks\" >forks</option>\n              <option value=\"help-wanted-issues\" >help-wanted-issues</option>\n              <option value=\"updated\" >updated</option>\n            </select>\n          </label>\n          <label class=\"field\" for=\"field-order\">\n            <span class=\"field-label\">Order</span>\n            <select class=\"field-input\" id=\"field-order\" name=\"order\">\n              <option value=\"\" selected>default</option>\n              <option value=\"desc\" >desc</option>\n              <option value=\"asc\" >asc</option>\n            </select>\n          </label>\n          <label class=\"field\" for=\"field-per_page\">\n  <span class=\"field-label\">Per page</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-per_page\" name=\"per_page\" value=\"\">\n</label>\n          <label class=\"field\" for=\"field-max_pages\">\n  <span class=\"field-label\">Max pages</span>\n  <input class=\"field-input\" type=\"number\" min=\"0\" id=\"field-max_pages\" name=\"max_pages\" value=\"\">\n</label>\n        </div>\n      </section>\n    </details>\n  </form>\n</section>\n<script>\n(function () {\n  \"use strict\";\n  var org = document.getElementById(\"field-org\");\n  var props = document.getElementById(\"filter-props\");\n  if (!org || !props) {\n    return;\n  }\n  function sync() {\n    var parts = org.value.trim().split(/\\s+/).filter(function (part) {\n      return part.length > 0;\n    });\n    var enabled = parts.length === 1;\n    props.disabled = !enabled;\n    props.setAttribute(\"data-props-enabled\", enabled ? \"true\" : \"false\");\n  }\n  org.addEventListener(\"input\", sync);\n})();\n</script>\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
}
